From 4c17b11082eb2fd965b2693c064e652488831676 Mon Sep 17 00:00:00 2001
From: dgabehar <dgabehar@gmail.com>
Date: Tue, 20 Oct 2026 13:01:25 -0500
Subject: [PATCH] qwen4exp: use ggml_ssm_conv_split for the GDN conv, dropping
 its concat

build_conv_state_split returns {history, transpose(x)} and writes the per-slot
rollback tails via build_conv_window (now exposed from delta-net-base.cpp), as
qwen35/qwen3next do. The PLE conv keeps its concat via build_conv_state_at.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01BidfYiPxg2nUvGVowCgTPK
---
 src/models/delta-net-base.cpp |  2 +-
 src/models/models.h           | 20 ++++++++++++++++++++
 src/models/qwen4exp.cpp       | 35 +++++++++++++++++++++++------------
 3 files changed, 44 insertions(+), 13 deletions(-)

diff --git a/src/models/delta-net-base.cpp b/src/models/delta-net-base.cpp
index 791db10dd..851abdda7 100644
--- a/src/models/delta-net-base.cpp
+++ b/src/models/delta-net-base.cpp
@@ -475,7 +475,7 @@ static ggml_tensor * build_token_cols(
     return ggml_transpose(ctx0, rows);
 }
 
-static ggml_tensor * build_conv_window(
+ggml_tensor * build_conv_window(
         ggml_context * ctx0,
         ggml_tensor  * prefix,     // [dm1, conv_channels, n_seqs], contiguous
         ggml_tensor  * new_tokens, // [n_t, conv_channels, n_seqs], possibly non-contiguous
diff --git a/src/models/models.h b/src/models/models.h
index b5ccb3a96..cad4645d3 100644
--- a/src/models/models.h
+++ b/src/models/models.h
@@ -17,6 +17,16 @@ static inline ggml_tensor * build_gdn_l2_norm(ggml_context * ctx, ggml_tensor *
     return ggml_scale(ctx, ggml_rms_norm(ctx, x, eps/n), 1.0f/sqrtf(n));
 }
 
+// width-(conv_kernel_size - 1) window of concat(prefix, new_tokens) without materializing it (delta-net-base.cpp)
+ggml_tensor * build_conv_window(
+        ggml_context * ctx0,
+        ggml_tensor  * prefix,
+        ggml_tensor  * new_tokens,
+        int64_t        dm1,
+        int64_t        conv_channels,
+        int64_t        n_seqs,
+        int64_t        s_idx);
+
 //
 // base classes
 //
@@ -2682,6 +2692,16 @@ struct llama_model_qwen4exp : public llama_model_base {
         std::map<ggml_tensor *, ggml_tensor *> rs_rows;
 
         // one conv history per cache tensor: delta-net and PLE each have their own
+        // same history/tails as build_conv_state_at, but returns {state, new_tokens} for
+        // ggml_ssm_conv_split instead of materializing concat(state, transpose(x))
+        std::pair<ggml_tensor *, ggml_tensor *> build_conv_state_split(
+             llm_graph_input_rs * inp,
+                    ggml_tensor * conv_states_all,
+                    ggml_tensor * x,
+                        int64_t   state_cols,
+                        int64_t   channels,
+                            int   il);
+
         ggml_tensor * build_conv_state_at(
              llm_graph_input_rs * inp,
                     ggml_tensor * conv_states_all,
diff --git a/src/models/qwen4exp.cpp b/src/models/qwen4exp.cpp
index 77430e7af..690143772 100644
--- a/src/models/qwen4exp.cpp
+++ b/src/models/qwen4exp.cpp
@@ -1067,14 +1067,14 @@ ggml_tensor * llama_model_qwen4exp::graph::build_layer_attn_linear(
     // the channels must match how load_arch_tensors sizes wqkv, not ssm_d_inner
     const int64_t conv_channels    = head_k_dim * num_k_heads * 2 + head_v_dim * num_v_heads;
 
-    ggml_tensor * conv_input = build_conv_state_at(inp, conv_states_all, qkv_mixed,
+    auto [conv_prefix, conv_new_tokens] = build_conv_state_split(inp, conv_states_all, qkv_mixed,
             conv_kernel_size - 1, conv_channels, il);
 
     ggml_tensor * state = build_rs(inp, ssm_states_all, hparams.n_embd_s(), n_seqs);
     state = ggml_reshape_4d(ctx0, state, head_v_dim, head_v_dim, num_v_heads, n_seqs);
     cb(state, "state_predelta", il);
 
-    ggml_tensor * conv_output_proper = ggml_ssm_conv(ctx0, conv_input, conv_kernel);
+    ggml_tensor * conv_output_proper = ggml_ssm_conv_split(ctx0, conv_prefix, conv_new_tokens, conv_kernel);
     cb(conv_output_proper, "conv_output_raw", il);
 
     ggml_tensor * conv_output_silu = ggml_silu(ctx0, conv_output_proper);
@@ -1293,9 +1293,10 @@ void llm_graph_input_qwen4exp_ple::set_input(const llama_ubatch * ubatch) {
     ggml_backend_tensor_set(rows, idx.data(), 0, idx.size()*ggml_element_size(rows));
 }
 
-// Read a conv history out of its own recurrent row and write the new tail back.
+// Read a conv history out of its own recurrent row and write the new tail back, without
+// materializing concat(history, transpose(x)): returns {history, transpose(x)}.
 // The shared build_conv_state cannot do this: qwen4exp has two such rows per layer.
-ggml_tensor * llama_model_qwen4exp::graph::build_conv_state_at(
+std::pair<ggml_tensor *, ggml_tensor *> llama_model_qwen4exp::graph::build_conv_state_split(
         llm_graph_input_rs * inp,
         ggml_tensor *        conv_states_all,
         ggml_tensor *        x,
@@ -1321,7 +1322,8 @@ ggml_tensor * llama_model_qwen4exp::graph::build_conv_state_at(
     ggml_tensor * state = ggml_reshape_3d(ctx0, rows, state_cols, channels, n_seqs);
     cb(state, "conv_state_at", il);
 
-    ggml_tensor * conv_input = ggml_concat(ctx0, state, ggml_transpose(ctx0, x), 0);
+    ggml_tensor * new_tokens = ggml_transpose(ctx0, x);
+    const int64_t n_t = new_tokens->ne[0];
 
     // [TAG_RECURRENT_ROLLBACK_SPLITS] keep the last state_cols columns once per rollback slot,
     // slot s ending s tokens earlier so a rollback of s tokens reads a history that never saw them
@@ -1331,22 +1333,31 @@ ggml_tensor * llama_model_qwen4exp::graph::build_conv_state_at(
     const int64_t n_slots = (int64_t) cparams.n_rs_seq + 1;
 
     for (int64_t slot = 0; slot < n_slots; ++slot) {
-        const int64_t s_idx = std::max<int64_t>(0, conv_input->ne[0] - state_cols - slot);
+        const int64_t s_idx = std::max<int64_t>(0, n_t - slot);
 
-        ggml_tensor * tail = ggml_view_3d(ctx0, conv_input,
-                state_cols, channels, n_seqs,
-                conv_input->nb[1], conv_input->nb[2],
-                ggml_row_size(conv_input->type, s_idx));
+        ggml_tensor * tail = build_conv_window(ctx0, state, new_tokens, state_cols, channels, n_seqs, s_idx);
 
         ggml_tensor * dst = ggml_view_2d(ctx0, conv_states_all,
                 state_cols * channels, n_seqs,
                 conv_states_all->nb[1],
                 (slot * mem_size + kv_head) * row_size);
 
-        ggml_build_forward_expand(gf, ggml_cpy(ctx0, ggml_cont(ctx0, tail), dst));
+        ggml_build_forward_expand(gf, ggml_cpy(ctx0, tail, dst));
     }
 
-    return conv_input;
+    return { state, new_tokens };
+}
+
+// Same, for the PLE conv, which wants the joined [state_cols + n_tokens, channels, n_seqs] buffer.
+ggml_tensor * llama_model_qwen4exp::graph::build_conv_state_at(
+        llm_graph_input_rs * inp,
+        ggml_tensor *        conv_states_all,
+        ggml_tensor *        x,
+        int64_t              state_cols,
+        int64_t              channels,
+        int                  il) {
+    auto [state, new_tokens] = build_conv_state_split(inp, conv_states_all, x, state_cols, channels, il);
+    return ggml_concat(ctx0, state, new_tokens, 0);
 }
 
 ggml_tensor * llama_model_qwen4exp::graph::build_inp_ple(
-- 
2.43.0

