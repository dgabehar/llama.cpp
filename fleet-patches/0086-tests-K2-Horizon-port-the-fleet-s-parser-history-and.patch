+                    { "<ifm|arg_key>path</ifm|arg_key>\n<ifm|arg_value>/x</ifm|arg_value>\n<ifm|arg_key>pattern</ifm|arg_key>\n<ifm|arg_value>Info</ifm|arg_value>\n",
+                      R"({"path":"/x","pattern":"Info"})" },
