+++++                    digit_range(to_str[i], to_str[i])
+++++                    out.append(" ")
+++++                    uniform_range(sub_zeros, to_sub)
+++++                out.append(")")
+++++            else:
+++++                out.append("[")
+++++                out.append(from_str[i])
+++++                out.append("-")
