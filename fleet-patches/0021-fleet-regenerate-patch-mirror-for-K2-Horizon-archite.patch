+++++                            to_reached = True
+++++                        else:
+++++                            digit_range(chr(ord(from_str[i]) + 1), chr(ord(to_str[i]) - 1))
+++++                        out.append(" ")
+++++                        more_digits(sub_len, sub_len)
+++++                if not to_reached:
