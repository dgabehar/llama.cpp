++            {%- if value is mapping or value is string or value is not sequence -%}{%- set RB.ok = false -%}{%- endif -%}
++        {%- elif key == 'required' -%}
++            {%- if value and not spec.properties -%}{%- set RB.ok = false -%}{%- endif -%}
