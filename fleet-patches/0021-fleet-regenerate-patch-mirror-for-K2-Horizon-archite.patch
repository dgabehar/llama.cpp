++            {%- else -%}{%- set RB.ok = false -%}{%- endif -%}
++        {%- elif key == 'type' -%}
++            {%- if value is mapping -%}{%- set RB.ok = false -%}{%- endif -%}
++        {%- elif key == 'enum' -%}
++            {%- if value is string or value is mapping or value is not sequence -%}{%- set RB.ok = false -%}{%- endif -%}
