+++++++++++-                    continue;
+++++++++++-                }
+++++++++++-                if (!may_be_string_impl(*child, visited)) {
+++++++++++-                    return false;
+++++++++++-                }
+++++++++++-                any_string = true;
+++++++++++-            }
+++++++++++-            return any_string;
+++++++++++-        }
+++++++++++-        default:
+++++++++++-            return false;
+++++++++++-    }
+++++++++++-}
+++++++++++-
+++++++++++-bool common_chat_schema::may_be_string() const {
+++++++++++-    std::unordered_set<const common_chat_schema *> visited;
