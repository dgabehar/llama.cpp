+++++++++{%- for type_name in spec.type -%}{{ render_markdown_type_name(type_name, spec) }}{% if not loop.last %} or {% endif %}{%- endfor -%}
+++++++++{%- elif spec.type is defined and spec.type is sequence and spec.type is not string -%}
+++++++++any
