+++++++++{%- elif spec.anyOf -%}
+++++++++anyOf[{%- for variant in spec.anyOf -%}{{ render_markdown_type(variant) }}{% if not loop.last %} or {% endif %}{%- endfor -%}]
+++++++++{%- elif spec.properties -%}
+++++++++object
+++++++++{%- elif 'items' in spec -%}
+++++++++array of {{ render_markdown_type(spec['items']) }}
+++++++++{%- else -%}
+++++++++any
+++++++++{%- endif -%}
