++++++++++++        case GGML_TYPE_F32:
++++++++++++            {
++++++++++++                ggml_compute_forward_ssm_conv_split_f32(params, dst);
++++++++++++            } break;
++++++++++++        default:
++++++++++++            {
++++++++++++                GGML_ABORT("fatal error");
++++++++++++            }
++++++++++++    }
++++++++++++}
