+++++++++            );
+++++++++            layer.ffn_down = create_tensor(
+++++++++                tn(LLM_TENSOR_FFN_DOWN, "weight", i),
+++++++++                {n_ff, n_embd},
+++++++++                0
+++++++++            );
+++++++++        }
+++++++++        
+++++++++    }
