From a2868918e032e1e477838362f47c1e0894a4dc61 Mon Sep 17 00:00:00 2001
From: dgabehar <dgabehar@gmail.com>
Date: Wed, 30 Sep 2026 09:24:25 -0500
Subject: [PATCH] K2 parser: surface a tool call only once its arguments are
 complete JSON

A call cut off by EOG/max_tokens (arguments healed to '{') was surfaced as a call; with tools offered the
K2 parser now hides it (streaming diffs stay monotonic) and, at the end of generation, falls back to
reasoning/content.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01BidfYiPxg2nUvGVowCgTPK
---
 common/chat.cpp     | 40 +++++++++++++++++++++++++++++-----------
 tests/test-chat.cpp | 22 ++++++++++++++++++++++
 2 files changed, 51 insertions(+), 11 deletions(-)

diff --git a/common/chat.cpp b/common/chat.cpp
index 4eb311e9eb..8117158574 100644
--- a/common/chat.cpp
+++ b/common/chat.cpp
@@ -1527,6 +1527,20 @@ common_chat_msg common_chat_peg_parse(const common_peg_arena &          src_pars
     common_peg_parse_context ctx(effective_input, flags);
     auto result = parser.parse(ctx);
 
+    // a parser that promises never to fail the turn (K2-Horizon): reasoning + the rest as content, else all text
+    auto lenient_fallback = [&]() {
+        common_chat_msg msg;
+        msg.role = "assistant";
+        common_peg_parse_context fctx(effective_input, flags);
+        auto fres = parser.parse(parser.get_rule("lenient-fallback"), fctx, 0);
+        if (!fres.fail()) {
+            common_chat_peg_mapper(msg).from_ast(fctx.ast, fres);
+        } else {
+            msg.content = input;
+        }
+        return msg;
+    };
+
     if (result.fail()) {
         // During partial parsing, return partial results if any AST nodes were captured
         // This allows streaming to work correctly for formats like FUNC_MARKDOWN_CODE_BLOCK
@@ -1552,17 +1566,7 @@ common_chat_msg common_chat_peg_parse(const common_peg_arena &          src_pars
         }
         LOG_WRN("%s: unparsed %s output: %s\n", __func__, common_chat_format_name(params.format), effective_input.substr(result.end).c_str());
         if (src_parser.has_rule("lenient-fallback")) {
-            // a parser that promises never to fail the turn (K2-Horizon): reasoning + the rest as content, else all text
-            common_chat_msg msg;
-            msg.role = "assistant";
-            common_peg_parse_context fctx(effective_input, flags);
-            auto fres = parser.parse(parser.get_rule("lenient-fallback"), fctx, 0);
-            if (!fres.fail()) {
-                common_chat_peg_mapper(msg).from_ast(fctx.ast, fres);
-            } else {
-                msg.content = input;
-            }
-            return msg;
+            return lenient_fallback();
         }
         LOG_DBG("%s: full %s output triggering error:\n=== BEGIN ===\n%s\n=== END ===\n", __func__, common_chat_format_name(params.format), effective_input.c_str());
         throw std::runtime_error(std::string("The model produced output that does not match the expected ") + common_chat_format_name(params.format) + " format");
@@ -1581,6 +1585,20 @@ common_chat_msg common_chat_peg_parse(const common_peg_arena &          src_pars
     }
     mapper->from_ast(ctx.ast, result);
 
+    if (src_parser.has_rule("lenient-fallback") && !msg.tool_calls.empty()) {
+        // K2-Horizon: a call is surfaced only once its arguments are complete JSON (the call block closed). A call cut
+        // off by EOG/max_tokens would otherwise run a tool with `{`; while streaming it also stays hidden until whole
+        // (the diffs only ever grow), at the end of generation the text falls back to reasoning/content.
+        const size_t n_calls = msg.tool_calls.size();
+        msg.tool_calls.erase(std::remove_if(msg.tool_calls.begin(), msg.tool_calls.end(),
+                                            [](const common_chat_tool_call & c) { return json::parse_no_throw(c.arguments).is_discarded(); }),
+                             msg.tool_calls.end());
+        if (!is_partial && msg.tool_calls.empty()) {
+            LOG_WRN("%s: dropped %zu tool call(s) with incomplete arguments\n", __func__, n_calls);
+            return lenient_fallback();
+        }
+    }
+
     if (ctx.is_debug()) {
         fprintf(stderr, "\nAST for %s parse:\n%s\n", is_partial ? "partial" : "full", ctx.ast.dump().c_str());
         fflush(stderr);
diff --git a/tests/test-chat.cpp b/tests/test-chat.cpp
index 17044ef1e0..3e3a9a5344 100644
--- a/tests/test-chat.cpp
+++ b/tests/test-chat.cpp
@@ -5435,6 +5435,28 @@ static void test_template_output_peg_parsers(bool detailed_debug) {
             assert_equals(true, m.content.find("<ifm|tool_call>{\"name\":\"bash\"}") != std::string::npos);
         }
 
+        // 6a'. a call cut off before its arguments are complete JSON is not surfaced as a call at the end of
+        // generation (it would run a tool with `{`); a complete one is
+        for (const char * effort : { "low", "high" }) {
+            const std::string close = std::string(effort) == "low" ? "</ifm|think_faster>" : "</ifm|think>";
+            const std::vector<std::string> cut = {
+                R"(<|tool_calls_section_begin|><|tool_call_begin|>functions.bash:0<|tool_call_argument_begin|>{)",
+                R"(<|tool_call_begin|>bash<|sep|>{"command":"l)",
+                "<ifm|tool_calls>\n<ifm|tool_call>bash\n<ifm|arg_key>command</ifm|arg_key>\n<ifm|arg_value>ls",
+                "<ifm|tool_calls>\n<ifm|tool_call>bash\n<ifm|arg_key>command</ifm|arg_key>",
+                "<ifm|tool_calls>\n<ifm|tool_call>bash\n<ifm|arg_key>",
+                "<ifm|tool_calls>\n<ifm|tool_call>bash\n{",
+                "<ifm|tool_calls>\n<ifm|tool_call>bash",
+            };
+            for (const auto & c : cut) {
+                for (const auto & pre : { std::string("Thinking."), "Thinking." + close + "Ok.\n" }) {
+                    auto m = stream_parse(make(effort, true), pre + c); // also: the streamed diffs stay valid
+                    assert_equals((size_t) 0, m.tool_calls.size());
+                    assert_equals(true, !trim_ws(m.reasoning_content + m.content).empty());
+                }
+            }
+        }
+
         // 6b. the parser never throws: whatever the model emits parses to something (fuzz, fixed seed)
         const std::vector<std::string> pieces = {
             "<ifm|think>", "<ifm|think_fast>", "<ifm|think_faster>", "</ifm|think>", "</ifm|think_fast>", "</ifm|think_faster>",
-- 
