From 33581fbd85d95a68c72c55f65a2678c10a2fc3ce Mon Sep 17 00:00:00 2001
From: dgabehar <dgabehar@gmail.com>
Date: Fri, 18 Sep 2026 12:51:57 -0500
Subject: [PATCH] fix: route ggml_backend_cpu_device_get_locality_mask through
 the DL proc-address table

CI's actual build config (-DGGML_BACKEND_DL=ON -DGGML_CPU_ALL_VARIANTS=ON)
builds the CPU backend as a runtime-loaded MODULE library, not something
libllama/common link against directly at build time -- confirmed via
ggml/src/CMakeLists.txt's ggml_add_backend_library(): under GGML_BACKEND_DL
the backend target is `add_library(... MODULE ...)` with no
target_link_libraries(ggml PUBLIC ${backend}), only a build-order
add_dependencies(). Every other CPU-only symbol common.cpp/llama-context.cpp
call (ggml_threadpool_new, ggml_backend_cpu_set_threadpool, ...) already goes
through ggml_backend_reg_get_proc_address() for exactly this reason; the two
new call sites for ggml_backend_cpu_device_get_locality_mask did not, which
is what broke the real CI build (undefined reference at link time) while a
local non-DL build stayed green. Fixes both call sites and adds the missing
entry to ggml_backend_cpu_get_proc_address()'s dispatch table.

Verified: full local build with the exact CI cmake flags (BACKEND_DL +
CPU_ALL_VARIANTS + Vulkan + RPC) now succeeds, and the existing
test-cpu-device-split CTest (non-DL config, exercises this exact function)
still passes.

Assisted-by: Claude Sonnet
---
 common/common.cpp              | 7 +++++--
 ggml/src/ggml-cpu/ggml-cpu.cpp | 3 +++
 src/llama-context.cpp          | 7 +++++--
 3 files changed, 13 insertions(+), 4 deletions(-)

diff --git a/common/common.cpp b/common/common.cpp
index f0af5c04b..178c8da44 100644
--- a/common/common.cpp
+++ b/common/common.cpp
@@ -1819,9 +1819,13 @@ std::vector<float> common_cpu_split_calibrate() {
             continue;
         }
 
+        ggml_backend_reg_t reg = ggml_backend_dev_backend_reg(dev);
+
         bool cpumask[GGML_MAX_N_THREADS];
         int  n_threads = 0;
-        if (ggml_backend_cpu_device_get_locality_mask(dev, cpumask)) {
+        auto * get_locality_mask_fn = (decltype(ggml_backend_cpu_device_get_locality_mask) *)
+            ggml_backend_reg_get_proc_address(reg, "ggml_backend_cpu_device_get_locality_mask");
+        if (get_locality_mask_fn && get_locality_mask_fn(dev, cpumask)) {
             for (int t = 0; t < GGML_MAX_N_THREADS; ++t) {
                 if (cpumask[t]) {
                     n_threads++;
@@ -1832,7 +1836,6 @@ std::vector<float> common_cpu_split_calibrate() {
             n_threads = (int) std::thread::hardware_concurrency();
         }
 
-        ggml_backend_reg_t reg = ggml_backend_dev_backend_reg(dev);
         auto * threadpool_new_fn  = (decltype(ggml_threadpool_new) *) ggml_backend_reg_get_proc_address(reg, "ggml_threadpool_new");
         auto * threadpool_free_fn = (decltype(ggml_threadpool_free) *) ggml_backend_reg_get_proc_address(reg, "ggml_threadpool_free");
         auto * set_threadpool_fn  = (decltype(ggml_backend_cpu_set_threadpool) *) ggml_backend_reg_get_proc_address(reg, "ggml_backend_cpu_set_threadpool");
diff --git a/ggml/src/ggml-cpu/ggml-cpu.cpp b/ggml/src/ggml-cpu/ggml-cpu.cpp
index b02760330..a37234bf0 100644
--- a/ggml/src/ggml-cpu/ggml-cpu.cpp
+++ b/ggml/src/ggml-cpu/ggml-cpu.cpp
@@ -857,6 +857,9 @@ static void * ggml_backend_cpu_get_proc_address(ggml_backend_reg_t reg, const ch
     if (strcmp(name, "ggml_backend_cpu_set_use_ref") == 0) {
         return (void *)ggml_backend_cpu_set_use_ref;
     }
+    if (strcmp(name, "ggml_backend_cpu_device_get_locality_mask") == 0) {
+        return (void *)ggml_backend_cpu_device_get_locality_mask;
+    }
 
     // threadpool - TODO:  move to ggml-base
     if (strcmp(name, "ggml_threadpool_new") == 0) {
diff --git a/src/llama-context.cpp b/src/llama-context.cpp
index c39034174..f3fd211bf 100644
--- a/src/llama-context.cpp
+++ b/src/llama-context.cpp
@@ -391,9 +391,13 @@ llama_context::llama_context(
                     throw std::runtime_error(format("failed to initialize %s backend", ggml_backend_dev_name(dev)));
                 }
 
+                ggml_backend_reg_t reg = ggml_backend_dev_backend_reg(dev);
+
                 bool cpumask[GGML_MAX_N_THREADS];
                 int  n_threads = 0;
-                if (ggml_backend_cpu_device_get_locality_mask(dev, cpumask)) {
+                auto * get_locality_mask_fn = (decltype(ggml_backend_cpu_device_get_locality_mask) *)
+                    ggml_backend_reg_get_proc_address(reg, "ggml_backend_cpu_device_get_locality_mask");
+                if (get_locality_mask_fn && get_locality_mask_fn(dev, cpumask)) {
                     for (int t = 0; t < GGML_MAX_N_THREADS; ++t) {
                         if (cpumask[t]) {
                             n_threads++;
@@ -404,7 +408,6 @@ llama_context::llama_context(
                     n_threads = GGML_DEFAULT_N_THREADS;
                 }
 
-                ggml_backend_reg_t reg = ggml_backend_dev_backend_reg(dev);
                 auto * threadpool_new_fn = (decltype(ggml_threadpool_new) *) ggml_backend_reg_get_proc_address(reg, "ggml_threadpool_new");
                 auto * set_threadpool_fn = (decltype(ggml_backend_cpu_set_threadpool) *) ggml_backend_reg_get_proc_address(reg, "ggml_backend_cpu_set_threadpool");
                 auto * set_n_threads_fn  = (decltype(ggml_backend_cpu_set_n_threads)  *) ggml_backend_reg_get_proc_address(reg, "ggml_backend_set_n_threads");
-- 
