From 8a6c9ed329d7ed5f0572a7fc8032cae89e4f1574 Mon Sep 17 00:00:00 2001
From: dgabehar <dgabehar@gmail.com>
Date: Thu, 24 Sep 2026 10:00:44 -0500
Subject: [PATCH] common : split-balance: key the calibration cache by build,
 expire after 7 days

The cache was keyed by device, model shape, type and n_ubatch only, so a
new build (different kernels) or a driver/firmware update kept serving
the old timings. Add the build commit to the key, store when each entry
was measured and measure again after 7 days (covers what the key can't
see: the remote worker's build, drivers, thermals).

Assisted-by: Claude Opus 5.5
---
 FLEET.md                 |  5 +++--
 common/split-balance.cpp | 16 +++++++++++++++-
 2 files changed, 18 insertions(+), 3 deletions(-)

diff --git a/FLEET.md b/FLEET.md
index a8a2537f1..574404faa 100644
--- a/FLEET.md
+++ b/FLEET.md
@@ -239,8 +239,9 @@ Patches (see `fleet-patches/README.md`):
   - At startup it times each device with synthetic matmuls shaped like the
     model's layers (RPC devices over the normal protocol, so the worker
     needs no change) and caches the result in
-    `~/.cache/llama.cpp/split-balance.json` (`--split-calibrate force` to
-    redo it).
+    `~/.cache/llama.cpp/split-balance.json`, keyed by device, model shape
+    and build and re-measured after 7 days (`--split-calibrate force` to
+    redo it now).
   - It picks layer counts that minimize the predicted time of a
     `--split-workload P:G` request (default 4096:256), capped by the fit
     memory projection.
diff --git a/common/split-balance.cpp b/common/split-balance.cpp
index 0877f7ebf..3f465bc7f 100644
--- a/common/split-balance.cpp
+++ b/common/split-balance.cpp
@@ -1,4 +1,5 @@
 #include "split-balance.h"
+#include "build-info.h"
 
 #include "common.h"
 #include "fit.h"
@@ -11,6 +12,7 @@
 #include "ggml-cpp.h"
 
 #include <algorithm>
+#include <chrono>
 #include <cmath>
 #include <cstring>
 #include <filesystem>
@@ -234,8 +236,10 @@ static std::string cache_key(ggml_backend_dev_t dev, int64_t n_embd, int64_t n_f
     size_t total = 0;
     ggml_backend_dev_memory(dev, &free, &total);
     std::ostringstream ss;
+    // the build is part of the key: kernels change between builds (the remote worker's build is not visible
+    // from here, driver/kernel upgrades neither, hence also the age limit on entries)
     ss << ggml_backend_dev_name(dev) << "|" << ggml_backend_dev_description(dev) << "|" << (total >> 20) << "MiB|"
-       << n_embd << "x" << n_ff << "|" << ggml_type_name(wtype) << "|ub" << n_ubatch;
+       << n_embd << "x" << n_ff << "|" << ggml_type_name(wtype) << "|ub" << n_ubatch << "|" << llama_commit();
     return ss.str();
 }
 
@@ -395,6 +399,11 @@ std::vector<common_split_device_perf> common_split_balance_calibrate(
         }
     }
 
+    // measurements older than this are taken again (driver, firmware or worker updates, thermal changes)
+    constexpr int64_t max_age_s = 7 * 24 * 3600;
+    const int64_t now_s = std::chrono::duration_cast<std::chrono::seconds>(
+            std::chrono::system_clock::now().time_since_epoch()).count();
+
     std::vector<common_split_device_perf> perf(devs.size());
     bool dirty = false;
     for (size_t i = 0; i < devs.size(); i++) {
@@ -402,6 +411,10 @@ std::vector<common_split_device_perf> common_split_balance_calibrate(
         if (cache.contains(key)) {
             try {
                 const common_json & e = cache.at(key);
+                const int64_t t_meas = e.value("measured_at", (int64_t) 0);
+                if (now_s - t_meas > max_age_s || t_meas > now_s) {
+                    throw std::runtime_error("stale");
+                }
                 perf[i].s_decode_byte  = e.at("s_decode_byte").get<double>();
                 perf[i].s_prefill_flop = e.at("s_prefill_flop").get<double>();
                 perf[i].t_hop          = e.at("t_hop").get<double>();
@@ -422,6 +435,7 @@ std::vector<common_split_device_perf> common_split_balance_calibrate(
             {"s_prefill_flop", perf[i].s_prefill_flop},
             {"t_hop",          perf[i].t_hop},
             {"s_hop_byte",     perf[i].s_hop_byte},
+            {"measured_at",    now_s},
         });
         dirty = true;
     }
-- 
