From 609f337189fb3bffd80d44b229d949751844ff51 Mon Sep 17 00:00:00 2001
From: dgabehar <dgabehar@gmail.com>
Date: Fri, 23 Oct 2026 10:31:14 -0500
Subject: [PATCH] tests/cpu: cover tiled concat with transposed i64 src1

test_concat_transposed skipped I64 because the CPU reference concat_any
asserted contiguous rows and aborted on a transposed src1. Copy strided
rows element by element for non-quantized types and add I64 to the
transposed-concat cases. Checked against the Vulkan tiled i64 path
(ggml_vk_concat_use_tiled -> concat_tiled_i64): 233/233 CONCAT tests pass,
no Vulkan change needed.

Assisted-by: Claude Sonnet
Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01BidfYiPxg2nUvGVowCgTPK
---
 ggml/src/ggml-cpu/ops.cpp  | 22 ++++++++++++++++++----
 tests/test-backend-ops.cpp |  3 +--
 2 files changed, 19 insertions(+), 6 deletions(-)

diff --git a/ggml/src/ggml-cpu/ops.cpp b/ggml/src/ggml-cpu/ops.cpp
index 8dfa92989..65e79cb8c 100644
--- a/ggml/src/ggml-cpu/ops.cpp
+++ b/ggml/src/ggml-cpu/ops.cpp
@@ -1924,8 +1924,10 @@ static void ggml_compute_forward_concat_any(
     const int32_t dim = ggml_get_op_params_i32(dst, 0);
 
     GGML_ASSERT(dim >= 0 && dim < 4);
-    GGML_ASSERT(ggml_is_contiguous_rows(src0));
-    GGML_ASSERT(ggml_is_contiguous_rows(src1));
+    // strided rows (e.g. a transposed src1) are copied element by element; quantized types need contiguous rows
+    const bool rows0 = ggml_is_contiguous_rows(src0);
+    const bool rows1 = ggml_is_contiguous_rows(src1);
+    GGML_ASSERT((rows0 && rows1) || !ggml_is_quantized(src0->type));
 
     int64_t o[4] = {0, 0, 0, 0};
 
@@ -1944,7 +1946,13 @@ static void ggml_compute_forward_concat_any(
             for (int i1 = 0; i1 < ne01; i1++) {
                 const char * x = (const char *) src0->data + i1*nb01 + i2*nb02 + i3*nb03;
                       char * y = (      char *) dst->data  + i1*nb1  + i2*nb2  + i3*nb3;
-                memcpy(y, x, ggml_row_size(src0->type, ne00));
+                if (rows0) {
+                    memcpy(y, x, ggml_row_size(src0->type, ne00));
+                } else {
+                    for (int64_t i0 = 0; i0 < ne00; i0++) {
+                        memcpy(y + i0*nb0, x + i0*nb00, ggml_type_size(src0->type));
+                    }
+                }
             }
         }
     }
@@ -1955,7 +1963,13 @@ static void ggml_compute_forward_concat_any(
             for (int i1 = 0; i1 < ne11; i1++) {
                 const char * x = (const char *) src1->data + i1*nb11         + i2*nb12         + i3*nb13;
                       char * y = (      char *)  dst->data + (i1 + o[1])*nb1 + (i2 + o[2])*nb2 + (i3 + o[3])*nb3 + o[0]*nb0;
-                memcpy(y, x, ggml_row_size(src1->type, ne10));
+                if (rows1) {
+                    memcpy(y, x, ggml_row_size(src1->type, ne10));
+                } else {
+                    for (int64_t i0 = 0; i0 < ne10; i0++) {
+                        memcpy(y + i0*nb0, x + i0*nb10, ggml_type_size(src1->type));
+                    }
+                }
             }
         }
     }
diff --git a/tests/test-backend-ops.cpp b/tests/test-backend-ops.cpp
index cb0fdf2d5..2e6e65af2 100644
--- a/tests/test-backend-ops.cpp
+++ b/tests/test-backend-ops.cpp
@@ -11903,8 +11903,7 @@ static std::vector<std::unique_ptr<test_case>> make_test_cases_eval() {
     }
 
     // transposed src1 (tiled Vulkan path), incl. sizes that are not multiples of the 32x32 tile
-    // (the CPU reference concat has no transposed-src1 path for 8-byte types)
-    for (ggml_type type : { GGML_TYPE_F32, GGML_TYPE_F16, GGML_TYPE_I8 }) {
+    for (ggml_type type : { GGML_TYPE_F32, GGML_TYPE_F16, GGML_TYPE_I8, GGML_TYPE_I64 }) {
         test_cases.emplace_back(new test_concat_transposed(type, 3, 10240, 2048, 1));
         test_cases.emplace_back(new test_concat_transposed(type, 3, 100, 37, 2));
         test_cases.emplace_back(new test_concat_transposed(type, 40, 33, 31, 3));
-- 
