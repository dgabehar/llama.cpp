+@pytest.mark.skipif(not os.environ.get("LLAMA_TEST_HYBRID_MODEL"), reason="LLAMA_TEST_HYBRID_MODEL not set")
+def test_grammar_spec_checkpoint_restore_hybrid(tmp_path, monkeypatch):
+    global server
