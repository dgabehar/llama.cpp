+    assert res.status_code == 200
+    tokens_plain = res.body["tokens"]
+    server.stop()
+
+    # default: the guard keeps grammar requests on plain decode
+    create_server()
+    server.start()
+    res = server.make_request("POST", "/completion", data=request)
+    assert res.status_code == 200
