From fd103a519d6967c1a9a38b095c6b1cabc5cdcb18 Mon Sep 17 00:00:00 2001
From: dgabehar <dgabehar@gmail.com>
Date: Fri, 25 Sep 2026 07:29:36 -0500
Subject: [PATCH] tests : rpc-server multiclient: cast RAND_MAX to float

clang's -Wimplicit-const-int-float-conversion (an error on the macOS CI)
rejects the implicit int->float conversion of RAND_MAX.

Assisted-by: Claude Opus 5.5
(cherry picked from commit 71719479e3dce2175289a127dc6c1706881d8f45)
---
 tests/test-rpc-server-multiclient.cpp | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/tests/test-rpc-server-multiclient.cpp b/tests/test-rpc-server-multiclient.cpp
index 83cf46aa2c..78c3f34248 100644
--- a/tests/test-rpc-server-multiclient.cpp
+++ b/tests/test-rpc-server-multiclient.cpp
@@ -349,11 +349,11 @@ static int mode_compute(const std::string & ep, int iters, int seed) {
     };
     std::vector<float> w(n * n), x(n), y_ref(n), y(n);
     srand(seed);
-    for (auto & v : w) { v = (float) rand() / RAND_MAX - 0.5f; }
+    for (auto & v : w) { v = (float) rand() / (float) RAND_MAX - 0.5f; }
 
     int failures = 0;
     for (int it = 0; it < iters; it++) {
-        for (auto & v : x) { v = (float) rand() / RAND_MAX - 0.5f; }
+        for (auto & v : x) { v = (float) rand() / (float) RAND_MAX - 0.5f; }
         for (int pass = 0; pass < 2; pass++) {
             ggml_backend_t backend = pass == 0 ? cpu : rpc;
             ggml_context * ctx = ggml_init(params);
-- 
