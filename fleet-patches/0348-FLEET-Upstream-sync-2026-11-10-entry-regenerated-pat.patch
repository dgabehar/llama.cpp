++    const int64_t n_t = new_tokens->ne[0];
++
++    const int64_t row_count = dm1 * conv_channels;
++
++    const size_t row_size  = ggml_row_size(conv_states_all->type, row_count);
++
++    if (cparams.n_rs_seq == 0) {
++        const int64_t s_idx  = n_t;
