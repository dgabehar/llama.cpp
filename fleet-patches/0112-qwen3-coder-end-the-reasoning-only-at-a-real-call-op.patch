From f6a35691bfeccc3b012bcd50d61c77a5cbe863a9 Mon Sep 17 00:00:00 2001
From: dgabehar <dgabehar@gmail.com>
Date: Mon, 26 Oct 2026 14:24:23 -0500
Subject: [PATCH] qwen3-coder: end the reasoning only at a real call opener,
 not a bare <tool_call>

Qwen3.5 thinking that mentions the tag as prose ("render them as <tool_call>
blocks") returned HTTP 500 "does not match the expected peg-native format":
2/16 on the spec_grammar_stress sweep (Qwen3.5-0.8B, CPU, tool_choice required).
The reasoning rule stopped at any <tool_call>, so the call parse then failed on
" blocks". The eager grammar let it through by splitting the tag across the
reasoning and content rules, and with tool_choice auto the bare tag in
thinking_end_tags ended the reasoning budget, which replays it into the lazy
grammar and forces a call mid-thought.

Fix: the reasoning ends at </think> or at "<tool_call>\n<function=" (the
reasoning rule, its peek and thinking_end_tags). The lazy trigger stays
<tool_call>; the budget's end-tag replay still fires it. The tool_choice none
path treats an end tag that starts with a call opener as that opener, and cuts
the reasoning at the end tag form, so a prose mention survives there too.
test-chat's reasoning-budget simulation now also models the end-tag replay.

Tests: Qwen3.5 prose mention in <think> followed by a call after </think> and
straight from the thinking, under tool_choice auto (lazy trigger checked by the
harness) and required, plus tool_choice none.

Assisted-by: Claude Opus 5.5
Claude-Session: https://claude.ai/code/session_01BidfYiPxg2nUvGVowCgTPK
---
 common/chat.cpp                | 24 +++++++++++++++-----
 common/parsers/qwen3-coder.cpp | 14 +++++++-----
 tests/test-chat.cpp            | 41 ++++++++++++++++++++++++++++++++++
 3 files changed, 68 insertions(+), 11 deletions(-)

diff --git a/common/chat.cpp b/common/chat.cpp
index 514cbce14..dc19f30d7 100644
--- a/common/chat.cpp
+++ b/common/chat.cpp
@@ -1944,12 +1944,22 @@ common_chat_msg common_chat_session::parse(bool is_partial) const {
     }
     // the none parser may put the call in the reasoning when the reasoning block is never closed (DeepSeek V4): the
     // reasoning is cut too, but only then, so a closed reasoning that mentions an opener (Ministral 3) is kept
-    const auto cut_at_openers = [&](std::string & text) -> bool {
+    const auto cut_at_openers = [&](std::string & text, bool reasoning = false) -> bool {
         size_t cut = std::string::npos;
         for (const auto & opener : call_openers) {
             size_t pos = std::string::npos;
             if (opener.type == COMMON_GRAMMAR_TRIGGER_TYPE_WORD) {
-                const std::string word = trim_whitespace(opener.value);
+                std::string word = trim_whitespace(opener.value);
+                // in the reasoning, a thinking end tag that extends the opener (Qwen3.5's `<tool_call>\n<function=`)
+                // is the real call: the bare opener there can be prose
+                if (reasoning) {
+                    for (const auto & end : thinking_ends) {
+                        const auto e = trim_whitespace(end);
+                        if (e.size() > word.size() && e.rfind(word, 0) == 0) {
+                            word = e;
+                        }
+                    }
+                }
                 pos = text.find(word);
                 if (pos == std::string::npos && is_partial) {
                     pos = string_find_partial_stop(text, word);
@@ -2015,16 +2025,18 @@ common_chat_msg common_chat_session::parse(bool is_partial) const {
         } catch (const std::exception &) {
         }
     }
-    // a thinking end tag that is also a call opener (DeepSeek V4 ends the reasoning at `<｜DSML｜tool_calls>`) does not
-    // close the reasoning here: the call it starts is what has to be cut
+    // a thinking end tag that is (or starts with) a call opener (DeepSeek V4 ends the reasoning at `<｜DSML｜tool_calls>`,
+    // Qwen3.5 at `<tool_call>\n<function=`) does not close the reasoning here: the call it starts is what has to be cut
     const bool reasoning_closed = std::any_of(thinking_ends.begin(), thinking_ends.end(), [&](const std::string & end) {
         const bool is_opener = std::any_of(call_openers.begin(), call_openers.end(), [&](const common_grammar_trigger & o) {
-            return o.type == COMMON_GRAMMAR_TRIGGER_TYPE_WORD && trim_whitespace(o.value) == trim_whitespace(end);
+            const auto opener = trim_whitespace(o.value);
+            return o.type == COMMON_GRAMMAR_TRIGGER_TYPE_WORD && !opener.empty() &&
+                   trim_whitespace(end).rfind(opener, 0) == 0;
         });
         return !end.empty() && !is_opener && input.text.find(end) != std::string::npos;
     });
     if (msg.content.empty() && !reasoning_closed) {
-        cut_at_openers(msg.reasoning_content);
+        cut_at_openers(msg.reasoning_content, true);
     }
     msg.tool_calls.clear();
     return msg;
diff --git a/common/parsers/qwen3-coder.cpp b/common/parsers/qwen3-coder.cpp
index 6774ede5c..50cb52684 100644
--- a/common/parsers/qwen3-coder.cpp
+++ b/common/parsers/qwen3-coder.cpp
@@ -20,12 +20,16 @@ common_chat_params common_chat_params_init_qwen3_coder(const common_chat_templat
 
     auto is_qwen3_coder  = !supports_reasoning;
 
+    // A call opened straight from the reasoning ends it too, but only a real one: the bare <tool_call> also
+    // shows up as prose inside the thinking ("render them as <tool_call> blocks")
+    const std::string REASONING_CALL_END = "<tool_call>\n<function=";
+
     if (supports_reasoning) {
         data.thinking_start_tag = "<think>";
-        // Support both </think> and <tool_call> as reasoning end sequences.
+        // Support both </think> and a call opener as reasoning end sequences.
         // The newline variant comes first so it is included in the forced message
-        // <function= is omitted, as it is a workaround for Qwen3-Coder which is not a thinking model
-        data.thinking_end_tags = { "\n</think>", "</think>", "<tool_call>" };
+        // A bare <function= is omitted, as it is a workaround for Qwen3-Coder which is not a thinking model
+        data.thinking_end_tags = { "\n</think>", "</think>", REASONING_CALL_END };
         data.preserved_tokens.insert(data.preserved_tokens.end(), { "<think>", "</think>" });
     }
 
@@ -77,8 +81,8 @@ common_chat_params common_chat_params_init_qwen3_coder(const common_chat_templat
         auto reasoning = p.eps();
         if (supports_reasoning && extract_reasoning) {
             reasoning = p.optional("<think>" + p.space() +
-                                   p.reasoning(p.until_one_of({ "</think>", "<tool_call>" })) +
-                                   (p.literal("</think>") | p.peek(p.literal("<tool_call>"))));
+                                   p.reasoning(p.until_one_of({ "</think>", REASONING_CALL_END })) +
+                                   (p.literal("</think>") | p.peek(p.literal(REASONING_CALL_END))));
         }
 
         // Response format parser
diff --git a/tests/test-chat.cpp b/tests/test-chat.cpp
index 11fe033ab..d520c54f4 100644
--- a/tests/test-chat.cpp
+++ b/tests/test-chat.cpp
@@ -1298,6 +1298,15 @@ static void test_peg_parser(common_chat_templates *                      tmpls,
                     for (const auto & think_end : think_ends) {
                         if (full_input.compare(i, think_end.size(), think_end) == 0) {
                             in_thinking = false;
+                            // the sampler replays the matched end tag into the grammar, so a trigger
+                            // inside it (Qwen3.5's `<tool_call>\n<function=`) fires there
+                            for (const auto & trigger : sampling.grammar_triggers) {
+                                const auto off = think_end.find(trigger.value);
+                                if (off != std::string::npos &&
+                                        (earliest_trigger_pos == std::string::npos || i + off < earliest_trigger_pos)) {
+                                    earliest_trigger_pos = i + off;
+                                }
+                            }
                             i += think_end.size() - 1;
                             break;
                         }
@@ -2363,6 +2372,38 @@ static void test_template_output_peg_parsers(bool detailed_debug) {
             .expect(message_assist_call_thoughts)
             .run();
 
+        // a bare <tool_call> written as prose in the thinking stays reasoning; only a real call opener ends it
+        {
+            const std::string call =
+                "<tool_call>\n<function=special_function>\n<parameter=arg1>\n1\n</parameter>\n</function>\n</tool_call>";
+            const std::string prose = "I'll render them as <tool_call> blocks.";
+            for (auto choice : { COMMON_CHAT_TOOL_CHOICE_AUTO, COMMON_CHAT_TOOL_CHOICE_REQUIRED }) {
+                tst.test(prose + "\n</think>\n\n" + call)
+                    .reasoning_format(COMMON_REASONING_FORMAT_AUTO)
+                    .tool_choice(choice)
+                    .tools({ special_function_tool })
+                    .expect_reasoning(prose)
+                    .expect_tool_calls({ { "special_function", R"({"arg1": 1})", {} } })
+                    .run();
+                // a call opened straight from the thinking, with no </think>
+                tst.test(prose + "\n" + call)
+                    .reasoning_format(COMMON_REASONING_FORMAT_AUTO)
+                    .tool_choice(choice)
+                    .tools({ special_function_tool })
+                    .expect_reasoning(prose)
+                    .expect_tool_calls({ { "special_function", R"({"arg1": 1})", {} } })
+                    .run();
+            }
+            // tool_choice none: the call opened from the unclosed thinking is still cut
+            tst.test(prose + "\n" + call)
+                .reasoning_format(COMMON_REASONING_FORMAT_AUTO)
+                .tool_choice(COMMON_CHAT_TOOL_CHOICE_NONE)
+                .tools({ special_function_tool })
+                .expect_reasoning(prose)
+                .expect_content("")
+                .run();
+        }
+
         tst.test(
                "<tool_call>\n"
                "<function=special_function>\n"
