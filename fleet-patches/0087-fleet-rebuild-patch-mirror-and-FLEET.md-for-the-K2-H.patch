+From 857323a2a86b0771413d13b6d01e07c4ddf692b5 Mon Sep 17 00:00:00 2001
+From: dgabehar <dgabehar@gmail.com>
+Date: Sat, 26 Sep 2026 19:15:58 -0500
+Subject: [PATCH] chat: gpt-oss parser accepts the "commentary (analysis)"
+ analysis header
+
+At long context gpt-oss-20b sometimes writes <|channel|>commentary
+(analysis)<|message|> for its reasoning. The strict PEG parser rejected the whole
+reply ("unparsed peg-native output"), llama-server returned an error, and
+LiteLLM retried in a loop (gpt-oss-20b-split, 44K-token prompts, 5 of 6 logged
+failures). The header is now parsed as reasoning. test-chat gets the real output
+as a case. FLEET.md notes the one variant not handled.
+
+Assisted-by: Claude Sonnet 5
+Co-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>
+Claude-Session: https://claude.ai/code/session_01BidfYiPxg2nUvGVowCgTPK
+(cherry picked from commit 6e18dc4169b8dd0ea07337df7d21d04816a67a57)
+---
+ common/parsers/gpt-oss.cpp | 4 +++-
+ tests/test-chat.cpp        | 8 ++++++++
+ 2 files changed, 11 insertions(+), 1 deletion(-)
+
+diff --git a/common/parsers/gpt-oss.cpp b/common/parsers/gpt-oss.cpp
+index 00beb41a47..ca62021c92 100644
+--- a/common/parsers/gpt-oss.cpp
++++ b/common/parsers/gpt-oss.cpp
+@@ -77,7 +77,9 @@ common_chat_params common_chat_params_init_gpt_oss(const common_chat_template &
+ 
+         // Occasionally, gpt-oss-20b will prefix channels with this commentary
+         auto stray_commentary = p.optional(p.literal("<|channel|>commentary") + p.optional(p.literal(" to=assistant")));
+-        auto start_analysis = stray_commentary + p.literal("<|channel|>analysis<|message|>");
++        // gpt-oss-20b also writes the analysis header as "commentary (analysis)" at long context
++        auto start_analysis = (stray_commentary + p.literal("<|channel|>analysis<|message|>")) |
++                              p.literal("<|channel|>commentary (analysis)<|message|>");
+ 
+         if (extract_reasoning) {
+             p.rule("analysis", start_analysis + p.reasoning(content) + end);
+diff --git a/tests/test-chat.cpp b/tests/test-chat.cpp
