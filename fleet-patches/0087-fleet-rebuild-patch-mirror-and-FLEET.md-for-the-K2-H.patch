++static void fill_f32(ggml_tensor * t) {
++    std::vector<float> data(ggml_nelements(t));
++    for (size_t i = 0; i < data.size(); i++) {
++        data[i] = (float) (i % 17) * 0.05f - 0.4f;
++    }
++    ggml_backend_tensor_set(t, data.data(), 0, ggml_nbytes(t));
++}
