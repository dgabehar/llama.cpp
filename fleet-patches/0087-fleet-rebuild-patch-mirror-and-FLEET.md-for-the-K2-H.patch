+                 if (ratio > 1.5 || ratio < 1.0 / busy_ratio) {
+                     LOG_INF("%s: %s runs at %.2fx its cached speed, calibrating again\n", __func__, name, 1.0 / ratio);
+-                    throw std::runtime_error("changed");
