+-        if (f) {
+-            std::stringstream ss;
+-            ss << f.rdbuf();
+-            cache = common_json::parse_no_throw(ss.str());
+-            if (!cache.is_object()) {
+-                cache = common_json::object();
++    auto read_cache = [&]() {
++        common_json c = common_json::object();
