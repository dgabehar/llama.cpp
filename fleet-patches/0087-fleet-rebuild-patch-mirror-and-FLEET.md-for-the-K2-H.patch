diff --git a/fleet-patches/0053-server-tests-keep-the-slot-busy-longer-than-the-save.patch b/fleet-patches/0053-server-tests-keep-the-slot-busy-longer-than-the-save.patch
new file mode 100644
index 0000000000..a3124fb04d
--- /dev/null
+++ b/fleet-patches/0053-server-tests-keep-the-slot-busy-longer-than-the-save.patch
@@ -0,0 +1,46 @@
+From f94f3d1a31d408b6480df711166baa4419baa5e1 Mon Sep 17 00:00:00 2001
+From: dgabehar <dgabehar@gmail.com>
+Date: Thu, 24 Sep 2026 20:37:55 -0500
+Subject: [PATCH] server tests: keep the slot busy longer than the save timeout
+ on fast hardware
+
+The tiny model stopped at its 2048-token training context after ~0.7 s on a
+GPU, before the 0.3 s + 500 ms window, so the save was never deferred.
+Shift the context and generate 12000 tokens.
+
+Assisted-by: Claude Opus 5.5
+(cherry picked from commit d06735f4c24d9cc526e99dc53091046e17d47d60)
+---
+ tools/server/tests/unit/test_slot_save.py | 9 +++++++--
+ 1 file changed, 7 insertions(+), 2 deletions(-)
+
+diff --git a/tools/server/tests/unit/test_slot_save.py b/tools/server/tests/unit/test_slot_save.py
+index 1240a459e2..a361866176 100644
+--- a/tools/server/tests/unit/test_slot_save.py
++++ b/tools/server/tests/unit/test_slot_save.py
+@@ -244,7 +244,11 @@ def test_slot_action_timeout_returns_error_instead_of_hanging():
+     # clear, distinct error instead of an indefinite hang.
+     global server
+     server.n_slots = 1  # single slot, easy to keep permanently busy
+-    server.n_ctx = 8192  # large enough that a real generation clearly outlasts the timeout below
++    # a real generation must clearly outlast the timeout below: the tiny test model stops at its
++    # 2048-token training context after ~0.7 s on a GPU, so shift the context and keep going
++    server.n_ctx = 8192
++    server.n_predict = 12000
++    server.enable_ctx_shift = True
+     server.slot_action_timeout_ms = 500
+     server.start()
+ 
+@@ -252,7 +256,8 @@ def test_slot_action_timeout_returns_error_instead_of_hanging():
+     def keep_slot_busy():
+         r = server.make_request("POST", "/completion", data={
+             "prompt": "Tell me a very long, very detailed story about dragons:",
+-            "n_predict": 8000,
++            "n_predict": 12000,
++            "ignore_eos": True,  # the tiny model ends its story early otherwise
+             "id_slot": 0,
+         }, timeout=90)
+         busy["status_code"] = r.status_code
+-- 
+2.43.0
+
diff --git a/fleet-patches/0054-models-fix-the-conv-state-window-over-the-transposed.patch b/fleet-patches/0054-models-fix-the-conv-state-window-over-the-transposed.patch
new file mode 100644
index 0000000000..e39e1d3e54
--- /dev/null
+++ b/fleet-patches/0054-models-fix-the-conv-state-window-over-the-transposed.patch
@@ -0,0 +1,91 @@
+From 0359ec5d4b739fa9dff707e15c51477e1b164bbb Mon Sep 17 00:00:00 2001
+From: dgabehar <dgabehar@gmail.com>
+Date: Thu, 24 Sep 2026 22:09:17 -0500
+Subject: [PATCH] models : fix the conv-state window over the transposed new
+ tokens
+
+build_conv_window (added with GGML_OP_SSM_CONV_SPLIT) cut token ranges out of
+new_tokens, a transposed view whose dim 0 has a row-sized stride, with
+ggml_view_3d. A view always gets a unit dim-0 stride, so any window wider than
+one new token read the wrong memory and saved a garbage conv state.
+
+Single-token decode only ever takes a 1-token slice, so plain generation
+looked fine. Prefill corrupted the state for the first few generated tokens,
+and draft-mtp verification (a 3-token ubatch plus rollback snapshots every
+step) corrupted it continuously: the target accepted tokens it gives ~0
+probability, which showed up as garbled reasoning and repeated </think> on
+Qwen3.8-27B.
+
+Cut the range from the untransposed [conv_channels, n_t, n_seqs] layout and
+transpose it back. On Qwen3.8-27B-UD-Q4_K_XL with draft-mtp n_max 2, 12
+sampled "Say OK." replies: tokens the plain target gives p < 0.002 went from
+22 to 0, replies with more than one </think> from 3/12 to 0/12, and draft
+acceptance rose from ~0.5 to 0.75-0.89.
+
+Assisted-by: Claude Opus 5.5
+(cherry picked from commit b9b9ecbd60c9eb2409fc10d71c3b8bba21efd386)
+---
+ src/models/delta-net-base.cpp | 33 ++++++++++++++++++++++++---------
+ 1 file changed, 24 insertions(+), 9 deletions(-)
+
+diff --git a/src/models/delta-net-base.cpp b/src/models/delta-net-base.cpp
+index 93866b61df..3f0e5ac0a5 100644
+--- a/src/models/delta-net-base.cpp
++++ b/src/models/delta-net-base.cpp
+@@ -456,6 +456,28 @@ std::pair<ggml_tensor *, ggml_tensor *> llm_build_delta_net_base::build_delta_ne
+ // kernel width. The straddling case is the one the old concat-based code got
+ // "for free"; here it costs a small (at most dm1-wide) concat instead of one
+ // sized by the full n_t.
++//
++// new_tokens is a transposed view: its dim 0 (tokens) has a row-sized stride.
++// ggml_view_* always gives a view a unit dim-0 stride, so a token range is cut
++// from the untransposed [conv_channels, n_t, n_seqs] layout and transposed back.
++static ggml_tensor * build_token_cols(
++        ggml_context * ctx0,
++        ggml_tensor  * new_tokens, // [n_t, conv_channels, n_seqs], transposed view
++        int64_t        start,
++        int64_t        count,
++        int64_t        conv_channels,
++        int64_t        n_seqs) {
++    ggml_tensor * rows = ggml_transpose(ctx0, new_tokens);
++    GGML_ASSERT(rows->nb[0] == ggml_type_size(rows->type));
++
++    rows = ggml_view_3d(ctx0, rows,
++            conv_channels, count, n_seqs,
++            rows->nb[1], rows->nb[2],
++            start * rows->nb[1]);
++
++    return ggml_transpose(ctx0, rows);
++}
++
+ static ggml_tensor * build_conv_window(
+         ggml_context * ctx0,
+         ggml_tensor  * prefix,     // [dm1, conv_channels, n_seqs], contiguous
+@@ -471,10 +493,7 @@ static ggml_tensor * build_conv_window(
+     }
+ 
+     if (s_idx >= dm1) {
+-        return ggml_view_3d(ctx0, new_tokens,
+-                dm1, conv_channels, n_seqs,
+-                new_tokens->nb[1], new_tokens->nb[2],
+-                (s_idx - dm1) * new_tokens->nb[0]);
++        return build_token_cols(ctx0, new_tokens, s_idx - dm1, dm1, conv_channels, n_seqs);
+     }
+ 
+     ggml_tensor * prefix_part =
+@@ -483,11 +502,7 @@ static ggml_tensor * build_conv_window(
+                 prefix->nb[1], prefix->nb[2],
+                 s_idx * prefix->nb[0]);
+ 
+-    ggml_tensor * new_tokens_part =
+-        ggml_view_3d(ctx0, new_tokens,
+-                s_idx, conv_channels, n_seqs,
+-                new_tokens->nb[1], new_tokens->nb[2],
+-                0);
++    ggml_tensor * new_tokens_part = build_token_cols(ctx0, new_tokens, 0, s_idx, conv_channels, n_seqs);
+ 
+     return ggml_concat(ctx0, prefix_part, new_tokens_part, 0);
+ }
+-- 
+2.43.0
+
diff --git a/fleet-patches/0055-vulkan-cap-an-integrated-GPU-s-total-free-memory-at-.patch b/fleet-patches/0055-vulkan-cap-an-integrated-GPU-s-total-free-memory-at-.patch
new file mode 100644
index 0000000000..bba48055b8
--- /dev/null
+++ b/fleet-patches/0055-vulkan-cap-an-integrated-GPU-s-total-free-memory-at-.patch
@@ -0,0 +1,72 @@
+From 3fa3818b9d6dafadc7b6febc71e8b36fa9558cbf Mon Sep 17 00:00:00 2001
+From: dgabehar <dgabehar@gmail.com>
+Date: Thu, 24 Sep 2026 22:13:07 -0500
+Subject: [PATCH] vulkan: cap an integrated GPU's total free memory at
+ MemAvailable
+
+Capping only the largest heap missed memory on RADV APUs: RADV splits GTT
+into a device-local heap (36.5 GiB on a Radeon 8060S with a 2 GiB carve-out)
+and a host heap (73 GiB). Both come out of host RAM, so the reported free
+stayed ~13 GiB above MemAvailable on gabesrv10 and 1-8 GiB above it on the
+780M/680M nodes.
+
+Cap the sum over all heaps instead. This under-reports by at most the BIOS
+VRAM carve-out, which MemAvailable does not include. Measured in the
+production pods: gabesrv10 47490 MiB free vs 47510 MiB MemAvailable,
+gabesrv06 29905 vs ~29800 MiB.
+
+Assisted-by: Claude Opus 5.5
+(cherry picked from commit 3f9b80c459509a886bb4de0892536c60d86950ff)
+---
+ ggml/src/ggml-vulkan/ggml-vulkan.cpp | 25 ++++++++-----------------
+ 1 file changed, 8 insertions(+), 17 deletions(-)
+
+diff --git a/ggml/src/ggml-vulkan/ggml-vulkan.cpp b/ggml/src/ggml-vulkan/ggml-vulkan.cpp
+index 7d2cf8c6ec..6679d0e0d9 100644
+--- a/ggml/src/ggml-vulkan/ggml-vulkan.cpp
++++ b/ggml/src/ggml-vulkan/ggml-vulkan.cpp
+@@ -15317,19 +15317,6 @@ void ggml_backend_vk_get_device_memory(int device, size_t * free, size_t * total
+     *total = 0;
+     *free = 0;
+ 
+-    // On an integrated GPU the largest heap is the one backed by host RAM (GTT). Drivers flag it
+-    // device-local or not depending on the carve-out size, so it is found by size. A carved-out
+-    // VRAM heap is separate from host RAM and is not capped.
+-    uint32_t host_heap = UINT32_MAX;
+-    if (is_integrated_gpu) {
+-        for (uint32_t i = 0; i < memprops.memoryProperties.memoryHeapCount; ++i) {
+-            if (host_heap == UINT32_MAX ||
+-                memprops.memoryProperties.memoryHeaps[i].size > memprops.memoryProperties.memoryHeaps[host_heap].size) {
+-                host_heap = i;
+-            }
+-        }
+-    }
+-
+     for (uint32_t i = 0; i < memprops.memoryProperties.memoryHeapCount; ++i) {
+         const vk::MemoryHeap & heap = memprops.memoryProperties.memoryHeaps[i];
+ 
+@@ -15340,13 +15327,17 @@ void ggml_backend_vk_get_device_memory(int device, size_t * free, size_t * total
+             if (membudget_supported && i < budgetprops.heapUsage.size()) {
+                 heap_free = budgetprops.heapBudget[i] - budgetprops.heapUsage[i];
+             }
+-            if (i == host_heap) {
+-                // the budget only counts GPU allocations, not what other processes hold
+-                heap_free = std::min(heap_free, ggml_vk_host_mem_available());
+-            }
+             *free += heap_free;
+         }
+     }
++
++    // An integrated GPU's heaps are carved out of host RAM: RADV, for one, splits GTT into a
++    // device-local and a host heap. Their budgets only count GPU allocations, not what other
++    // processes hold, so cap the total at what the host has available. This under-reports by
++    // at most the BIOS VRAM carve-out, which is not part of MemAvailable.
++    if (is_integrated_gpu) {
++        *free = std::min(*free, ggml_vk_host_mem_available());
++    }
+ }
+ 
+ static vk::PhysicalDeviceType ggml_backend_vk_get_device_type(int device_idx) {
+-- 
+2.43.0
+
