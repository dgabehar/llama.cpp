++        // EOG alone pushed it into a repetition loop instead). The close tag takes the best EOG logit.
++        const auto find = [&](llama_token id) -> llama_token_data * {
++            if (id >= 0 && (size_t) id < cur_p->size && cur_p->data[id].id == id) {
