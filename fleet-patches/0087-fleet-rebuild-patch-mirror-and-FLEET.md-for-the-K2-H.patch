++            $<TARGET_FILE:test-rpc-client-timeout>)
++    set_property(TEST test-rpc-client-timeout PROPERTY LABELS main)
++    set_property(TEST test-rpc-client-timeout PROPERTY TIMEOUT 60)
+ endif()
