diff --git a/fleet-patches/0034-llama-restore-the-worst-case-sched-plan-before-large.patch b/fleet-patches/0034-llama-restore-the-worst-case-sched-plan-before-large.patch
new file mode 100644
index 0000000000..274ebe7caa
--- /dev/null
+++ b/fleet-patches/0034-llama-restore-the-worst-case-sched-plan-before-large.patch
@@ -0,0 +1,140 @@
+From d6eefe2210a9394d0fc607257286d2f01b4054d3 Mon Sep 17 00:00:00 2001
+From: dgabehar <dgabehar@gmail.com>
+Date: Wed, 23 Sep 2026 23:45:55 -0500
+Subject: [PATCH] llama : restore the worst-case sched plan before large
+ ubatches
+
+With pipeline parallelism, small graphs (below the GPU op-offload batch
+size) are placed differently by the scheduler and replace the reserved
+worst-case allocation plan. The next large ubatch then gets a plan sized
+for itself, and every later ubatch with a bigger KV view reallocates,
+which synchronizes all backends and drains the pipeline (1.19 s stall
+before the tail ubatch of a prompt in llama-server).
+
+Factor the pp-graph reserve out of sched_reserve and re-run it before
+the first ubatch of >= 32 tokens that follows a small one.
+
+Assisted-by: Claude Opus 5.5
+(cherry picked from commit 4d7bde79f5c4d6969e03e1d6c986af415feaff2b)
+---
+ src/llama-context.cpp | 63 ++++++++++++++++++++++++++++++-------------
+ src/llama-context.h   |  8 ++++++
+ 2 files changed, 52 insertions(+), 19 deletions(-)
+
+diff --git a/src/llama-context.cpp b/src/llama-context.cpp
+index 2beb98b9ad..188da298c2 100644
+--- a/src/llama-context.cpp
++++ b/src/llama-context.cpp
+@@ -686,6 +686,30 @@ static int llama_graph_n_input_tensors(ggml_cgraph * gf) {
+     return (int) users.size();
+ }
+ 
++bool llama_context::graph_reserve_worst_pp(const llama_memory_context_i * mctx) {
++    const uint32_t n_seqs       = cparams.n_seq_max;
++    const uint32_t n_tokens     = std::min(cparams.n_ctx, cparams.n_ubatch);
++    const uint32_t n_outputs_pp = std::min(n_tokens, cparams.n_outputs_max);
++
++    // TODO: the worst case graph is not always reached for `n_seqs > 1`
++    //       need to implement a more robust mechanism that tries a few different inputs and analyzes the results
++    ggml_cgraph * gf = nullptr;
++    switch (model.arch) {
++        case LLM_ARCH_KIMI_LINEAR:
++        case LLM_ARCH_MINIMAX_01:
++            // [TAG_RESERVE_DIAG_DECAY]
++            // the `inp_diag_decay` tensor size scales with `n_seq_tokens^2` which
++            // makes `n_seqs == 1` use more memory for the compute graph compared to `n_seqs > 1`
++            gf = graph_reserve(n_tokens, 1,      n_outputs_pp, mctx, model.hparams.no_alloc);
++            break;
++        default:
++            gf = graph_reserve(n_tokens, n_seqs, n_outputs_pp, mctx, model.hparams.no_alloc);
++    };
++
++    sched_plan_worst_pp = gf != nullptr;
++    return gf != nullptr;
++}
++
+ void llama_context::sched_reserve() {
+     if (!sched_need_reserve) {
+         return;
+@@ -785,25 +809,8 @@ void llama_context::sched_reserve() {
+     }
+ 
+     // reserve again with pp graph to avoid ggml-alloc reallocations during inference
+-    {
+-        // TODO: the worst case graph is not always reached for `n_seqs > 1`
+-        //       need to implement a more robust mechanism that tries a few different inputs and analyzes the results
+-        ggml_cgraph * gf = nullptr;
+-        switch (model.arch) {
+-            case LLM_ARCH_KIMI_LINEAR:
+-            case LLM_ARCH_MINIMAX_01:
+-                // [TAG_RESERVE_DIAG_DECAY]
+-                // the `inp_diag_decay` tensor size scales with `n_seq_tokens^2` which
+-                // makes `n_seqs == 1` use more memory for the compute graph compared to `n_seqs > 1`
+-                gf = graph_reserve(n_tokens, 1,      n_outputs_pp, mctx.get(), model.hparams.no_alloc);
+-                break;
+-            default:
+-                gf = graph_reserve(n_tokens, n_seqs, n_outputs_pp, mctx.get(), model.hparams.no_alloc);
+-        };
+-
+-        if (!gf) {
+-            throw std::runtime_error("failed to allocate compute pp buffers");
+-        }
++    if (!graph_reserve_worst_pp(mctx.get())) {
++        throw std::runtime_error("failed to allocate compute pp buffers");
+     }
+ 
+     for (size_t i = 0; i < backend_ptrs.size(); ++i) {
+@@ -1502,6 +1509,24 @@ llm_graph_result * llama_context::process_ubatch(const llama_ubatch & ubatch, ll
+ 
+         n_reused++;
+     } else {
++        // Small graphs are placed differently by the scheduler (ops move between backends
++        // below the offload batch size) and replace the worst-case allocation plan. A large
++        // graph allocated after that gets a plan sized for itself, so every later ubatch
++        // with a bigger KV view reallocates, which synchronizes all backends and stops
++        // pipeline parallelism. Restore the worst-case plan first instead.
++        constexpr uint32_t n_tokens_large = 32; // default op offload batch size of the GPU backends
++        if (cparams.pipeline_parallel && memory && !model.hparams.no_alloc) {
++            if (ubatch.n_tokens < n_tokens_large) {
++                sched_plan_worst_pp = false;
++            } else if (!sched_plan_worst_pp) {
++                // the full-memory context is a placeholder for sizing and leaves the cache untouched
++                auto mctx_full = memory->init_full();
++                if (mctx_full) {
++                    graph_reserve_worst_pp(mctx_full.get());
++                }
++            }
++        }
++
+         gf_res_prev_active = nullptr;
+         res->reset();
+ 
+diff --git a/src/llama-context.h b/src/llama-context.h
+index ef1793c5a1..56eea13be7 100644
+--- a/src/llama-context.h
++++ b/src/llama-context.h
+@@ -255,6 +255,9 @@ public:
+     ggml_status graph_compute(ggml_cgraph * gf, bool batched);
+ 
+     // reserve a graph with a dummy ubatch of the specified size
++    // reserves the worst-case prompt-processing graph, see sched_plan_worst_pp
++    bool graph_reserve_worst_pp(const llama_memory_context_i * mctx);
++
+     ggml_cgraph * graph_reserve(
+         uint32_t n_tokens, uint32_t n_seqs, uint32_t n_outputs, const llama_memory_context_i * mctx, bool split_only = false, size_t * sizes = nullptr);
+ 
+@@ -373,6 +376,11 @@ private:
+     };
+ 
+     copy_experts_info copy_experts;
++    // true while the scheduler's allocation plan is the worst-case prompt-processing
++    // graph from sched_reserve; small graphs (token generation) replace that plan, and
++    // allocating large graphs against a plan sized for the current graph reallocates
++    // (and synchronizes every backend) each time the KV cache grows
++    bool sched_plan_worst_pp = false;
+ 
+     ggml_backend_t backend_cpu = nullptr;
+     std::vector<ggml_backend_ptr> backends;
+-- 
+2.43.0
+
diff --git a/fleet-patches/0035-common-split-balance-for-speed-aware-layer-splits.patch b/fleet-patches/0035-common-split-balance-for-speed-aware-layer-splits.patch
new file mode 100644
index 0000000000..4ab129d000
--- /dev/null
+++ b/fleet-patches/0035-common-split-balance-for-speed-aware-layer-splits.patch
@@ -0,0 +1,1202 @@
+From 31f5f3e49e0c7eefc00ca7b640fbc10b2acad28a Mon Sep 17 00:00:00 2001
+From: dgabehar <dgabehar@gmail.com>
+Date: Wed, 23 Sep 2026 23:45:55 -0500
+Subject: [PATCH] common : --split-balance for speed-aware layer splits
+
+A layer split runs the devices one after another for every token, so
+splitting by free memory (the default) is the slowest choice when the
+devices differ in speed: on gabesrv10 (8060S) + gabesrv06 (780M, RPC)
+it put 33% of Qwen3.8-27B on the slow GPU, giving pp8192 204 t/s and
+tg 7.2 t/s vs 297/12.1 on one node.
+
+New modes:
+  memory   split by free memory (previous behavior)
+  decode   fill the fastest devices first
+  prefill  balance pipeline stage times
+  auto     minimize predicted time of a --split-workload P:G request
+           (default 4096:256); the default
+
+Each device is timed with synthetic matmuls shaped like the model's
+layers (decode: single-token, prefill: n_ubatch-token), remote RPC
+devices over the normal protocol with a readback, plus RPC hop latency
+and bandwidth. Results are cached (--split-calibrate cache|force).
+Memory caps come from the fit projection; the chosen split is verified
+against it and shrunk on overflow. An explicit -ts always wins.
+
+tests: test-split-balance checks the optimizer against brute force and
+the expected decode/prefill/auto behavior.
+
+Assisted-by: Claude Opus 5.5
+(cherry picked from commit 99a069a61428b1ff83888195013e868ebab0d584)
+---
+ common/CMakeLists.txt        |   2 +
+ common/arg.cpp               |  38 ++
+ common/common.cpp            |  11 +
+ common/common.h              |   6 +
+ common/fit.cpp               |  49 +++
+ common/fit.h                 |  11 +
+ common/split-balance.cpp     | 688 +++++++++++++++++++++++++++++++++++
+ common/split-balance.h       |  96 +++++
+ tests/CMakeLists.txt         |   1 +
+ tests/test-split-balance.cpp | 142 ++++++++
+ 10 files changed, 1044 insertions(+)
+ create mode 100644 common/split-balance.cpp
+ create mode 100644 common/split-balance.h
+ create mode 100644 tests/test-split-balance.cpp
+
+diff --git a/common/CMakeLists.txt b/common/CMakeLists.txt
+index c738451a01..5cc100afff 100644
+--- a/common/CMakeLists.txt
++++ b/common/CMakeLists.txt
+@@ -108,6 +108,8 @@ add_library(${TARGET}
+     sampling.h
+     speculative.cpp
+     speculative.h
++    split-balance.cpp
++    split-balance.h
+     subproc.cpp
+     subproc.h
+     trie.cpp
+diff --git a/common/arg.cpp b/common/arg.cpp
+index dedec3d081..2fac286057 100644
+--- a/common/arg.cpp
++++ b/common/arg.cpp
+@@ -2749,6 +2749,44 @@ common_params_context common_params_parser_init(common_params & params, llama_ex
+             else { throw std::invalid_argument("invalid value"); }
+         }
+     ).set_env("LLAMA_ARG_CPU_SPLIT"));
++    add_opt(common_arg(
++        {"--split-balance"}, "auto|decode|prefill|memory",
++        "how to split layers across devices when --tensor-split is not given (default: auto)\n"
