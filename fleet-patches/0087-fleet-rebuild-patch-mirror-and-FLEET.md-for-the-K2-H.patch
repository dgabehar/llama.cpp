diff --git a/fleet-patches/0045-vulkan-on-integrated-GPUs-cap-the-free-memory-of-hos.patch b/fleet-patches/0045-vulkan-on-integrated-GPUs-cap-the-free-memory-of-hos.patch
new file mode 100644
index 0000000000..a16bb24f26
--- /dev/null
+++ b/fleet-patches/0045-vulkan-on-integrated-GPUs-cap-the-free-memory-of-hos.patch
@@ -0,0 +1,88 @@
+From 5d7c6d6b17d9c39510e656ee25a884820eab04c1 Mon Sep 17 00:00:00 2001
+From: dgabehar <dgabehar@gmail.com>
+Date: Thu, 24 Sep 2026 17:15:06 -0500
+Subject: [PATCH] vulkan: on integrated GPUs, cap the free memory of host heaps
+ at MemAvailable
+
+The GTT budget only counts GPU allocations; memory that other processes hold
+is not subtracted, so -fit and --split-balance could plan for more than the
+host had (QA 2026-09-24: 24.2 GiB free reported with 18.8 GiB MemAvailable,
+and a DeviceLost on an over-committed gabesrv06). Device-local heaps (a VRAM
+carve-out) are not capped.
+
+Assisted-by: Claude Opus 5.5
+(cherry picked from commit 333cce3751fa0680a496ae50bba1f2bec5b660fd)
+---
+ ggml/src/ggml-vulkan/ggml-vulkan.cpp | 38 ++++++++++++++++++++++++++--
+ 1 file changed, 36 insertions(+), 2 deletions(-)
+
+diff --git a/ggml/src/ggml-vulkan/ggml-vulkan.cpp b/ggml/src/ggml-vulkan/ggml-vulkan.cpp
+index bc12d60825..2f7572b30a 100644
+--- a/ggml/src/ggml-vulkan/ggml-vulkan.cpp
++++ b/ggml/src/ggml-vulkan/ggml-vulkan.cpp
+@@ -15274,6 +15274,31 @@ void ggml_backend_vk_get_device_description(int device, char * description, size
+     ggml_vk_get_device_description(dev_idx, description, description_size);
+ }
+ 
++// Host RAM the kernel could hand out now (MemAvailable), or SIZE_MAX if unknown.
++// The GTT budget of an integrated GPU only counts GPU allocations, not the host
++// memory that other processes already hold, so on its own it over-reports free.
++static size_t ggml_vk_host_mem_available() {
++#ifdef __linux__
++    FILE * f = fopen("/proc/meminfo", "r");
++    if (f != nullptr) {
++        char line[256];
++        unsigned long long kb = 0;
++        bool found = false;
++        while (fgets(line, sizeof(line), f)) {
++            if (sscanf(line, "MemAvailable: %llu kB", &kb) == 1) {
++                found = true;
++                break;
++            }
++        }
++        fclose(f);
++        if (found) {
++            return (size_t) kb * 1024;
++        }
++    }
++#endif
++    return SIZE_MAX;
++}
++
+ void ggml_backend_vk_get_device_memory(int device, size_t * free, size_t * total) {
+     GGML_ASSERT(device < (int) vk_instance.device_indices.size());
+     GGML_ASSERT(device < (int) vk_instance.device_supports_membudget.size());
+@@ -15292,19 +15317,28 @@ void ggml_backend_vk_get_device_memory(int device, size_t * free, size_t * total
+     *total = 0;
+     *free = 0;
+ 
++    size_t host_free = 0; // free in heaps backed by host RAM (integrated GPUs)
++
+     for (uint32_t i = 0; i < memprops.memoryProperties.memoryHeapCount; ++i) {
+         const vk::MemoryHeap & heap = memprops.memoryProperties.memoryHeaps[i];
+ 
+         if (is_integrated_gpu || (heap.flags & vk::MemoryHeapFlagBits::eDeviceLocal)) {
+             *total += heap.size;
+ 
++            size_t heap_free = heap.size;
+             if (membudget_supported && i < budgetprops.heapUsage.size()) {
+-                *free += budgetprops.heapBudget[i] - budgetprops.heapUsage[i];
++                heap_free = budgetprops.heapBudget[i] - budgetprops.heapUsage[i];
++            }
++            if (is_integrated_gpu && !(heap.flags & vk::MemoryHeapFlagBits::eDeviceLocal)) {
++                host_free += heap_free;
+             } else {
+-                *free += heap.size;
++                *free += heap_free;
+             }
+         }
+     }
++    // a carved-out device-local heap is separate from host RAM; the host heap cannot
++    // hand out more than the host has available
++    *free += std::min(host_free, ggml_vk_host_mem_available());
+ }
+ 
