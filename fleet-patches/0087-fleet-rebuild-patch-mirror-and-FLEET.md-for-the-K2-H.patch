@@ -0,0 +1,72 @@
+From de98be5d4890d9788b351d7457e4bb966a831d55 Mon Sep 17 00:00:00 2001
+From: dgabehar <dgabehar@gmail.com>
+Date: Fri, 18 Sep 2026 13:23:17 -0500
+Subject: [PATCH] fix: don't reject a GPU's host buffer type in
+ ggml_backend_cpu_device_supports_buft
+
+Real production incident (2026-09-18, both gabesrv06 and gabesrv10):
+GGML_ASSERT(ggml_backend_supports_buft(backends[b], sched->bufts[b]))
+failed in ggml_backend_sched_new, crash-looping the server on model load --
+even on gabesrv06, a monolithic-die node where this feature should have
+been a complete no-op (1 detected domain, identical to pre-feature
+behavior).
+
+Root cause: the device-identity guard added for this feature
+(buft->device != nullptr && buft->device != dev -> reject) was meant to
+stop domain N's private layer_buft from being accepted by domain M's CPU
+backend. But llama_context's pre-existing backend init
+(src/llama-context.cpp) substitutes a GPU's own host buffer type for the
+CPU backend's buft whenever model.devices is non-empty (an existing,
+unrelated optimization for fast CPU<->GPU transfer) -- and that host buft
+also carries a non-null buft->device (the GPU itself). The guard rejected
+that too, on every node with GPU offload, regardless of CPU domain count.
+
+Fix: only reject when buft->device is itself a CPU-type device different
+from dev -- a GPU's host buft (or anything else) is unaffected and keeps
+the pre-existing supports_buft behavior.
+
+Verified this time with a REAL model load (not just --help/build), with
+GPU offload (-ngl 999) and --cpu-split auto explicitly enabled, plus a
+real completion round-trip -- gap in the previous fix's verification that
+let this reach production; won't skip a real model-load smoke test again
+before the next deploy.
+
+Assisted-by: Claude Sonnet
+(cherry picked from commit 1e574238cc5c3d741147c0c99a1f01bb291e699e)
+---
+ ggml/src/ggml-cpu/ggml-cpu.cpp | 16 ++++++++++------
+ 1 file changed, 10 insertions(+), 6 deletions(-)
+
+diff --git a/ggml/src/ggml-cpu/ggml-cpu.cpp b/ggml/src/ggml-cpu/ggml-cpu.cpp
+index d67ad27195..87d43d5b1f 100644
+--- a/ggml/src/ggml-cpu/ggml-cpu.cpp
++++ b/ggml/src/ggml-cpu/ggml-cpu.cpp
+@@ -622,15 +622,19 @@ static bool ggml_backend_cpu_device_supports_op(ggml_backend_dev_t dev, const st
+ }
+ 
+ static bool ggml_backend_cpu_device_supports_buft(ggml_backend_dev_t dev, ggml_backend_buffer_type_t buft) {
+-    // A buft tagged for a specific device (a GPU's own buffer type, or another CPU locality
+-    // domain's per-domain layer_buft) is only supported by that exact device; buft->device ==
+-    // NULL is the shared/generic case (the plain CPU singleton, extra bufts), supported by every
+-    // CPU device, same as before this feature existed.
+-    if (buft->device != nullptr && buft->device != dev) {
++    // Reject only ANOTHER CPU locality domain's own private layer_buft (buft->device is a CPU
++    // device that isn't this one) -- that's the only case this feature needs to route away from
++    // the wrong domain's backend. A GPU's own host buffer type also carries a non-null
++    // buft->device (the GPU itself), but is legitimately usable by any CPU backend regardless of
++    // device identity -- that's the entire point of the pre-existing host-buffer CPU<->GPU
++    // transfer optimization in llama_context's backend init (llama-context.cpp), which predates
++    // this feature and must not be broken by it. buft->device == NULL is the shared/generic case
++    // (the plain CPU singleton, extra bufts), supported by every CPU device, same as always.
++    if (buft->device != nullptr && buft->device != dev &&
++        ggml_backend_dev_type(buft->device) == GGML_BACKEND_DEVICE_TYPE_CPU) {
+         return false;
+     }
+     return ggml_backend_buft_is_host(buft) || ggml_backend_cpu_is_extra_buffer_type(buft);
+-    GGML_UNUSED(dev);
+ }
+ 
+ static const struct ggml_backend_device_i ggml_backend_cpu_device_i = {
+-- 
+2.43.0
+
diff --git a/fleet-patches/0023-fix-correct-units-in-CPU-split-calibration-log-line-.patch b/fleet-patches/0023-fix-correct-units-in-CPU-split-calibration-log-line-.patch
new file mode 100644
index 0000000000..1a9f795130
--- /dev/null
+++ b/fleet-patches/0023-fix-correct-units-in-CPU-split-calibration-log-line-.patch
@@ -0,0 +1,49 @@
+From d1d8de3720f89433279e0969802ab2ef24b8f642 Mon Sep 17 00:00:00 2001
+From: dgabehar <dgabehar@gmail.com>
+Date: Fri, 18 Sep 2026 14:12:34 -0500
+Subject: [PATCH] =?UTF-8?q?fix:=20correct=20units=20in=20CPU=20split=20cal?=
+ =?UTF-8?q?ibration=20log=20line=20(=C2=B5s,=20not=20seconds)?=
+MIME-Version: 1.0
+Content-Type: text/plain; charset=UTF-8
+Content-Transfer-Encoding: 8bit
+
+Live-observed on gabesrv10 (post-fix rollout, 2026-09-18): the calibration
+log printed "7701384.6154 ms/iter" -- nonsensical (2+ hours/iter would
+never let the server start in under 2 minutes). time_cell_median()
+(tools/tuning/bench.cpp) returns microseconds (ggml_time_us()-based), not
+seconds; the log line multiplied by 1000 as if converting seconds->ms,
+inflating the printed value by ~1e6x.
+
+Cosmetic only -- weight = 1.0/t is a relative-throughput ratio, and a
+systematic unit-scaling error applied identically to every domain cancels
+out in that ratio, so the actual per-layer split was never affected.
+Fixing the log line's correctness anyway rather than leaving it wrong.
+
+Assisted-by: Claude Sonnet
+(cherry picked from commit b2fcf83bf6905ce19c4af1aec5e7f2d8b9dfcb29)
+---
+ common/common.cpp | 7 ++++++-
+ 1 file changed, 6 insertions(+), 1 deletion(-)
+
+diff --git a/common/common.cpp b/common/common.cpp
+index 8fcae66db4..38be89c9e4 100644
+--- a/common/common.cpp
++++ b/common/common.cpp
+@@ -1831,8 +1831,13 @@ std::vector<float> common_cpu_split_calibrate() {
+             const double t = time_cell_median(backend, cell, /* reps = */ 5);
+             if (t > 0.0) {
+                 weight = (float) (1.0 / t); // relative throughput; llama-model.cpp normalizes this
++                // time_cell_median() (tools/tuning/bench.cpp) returns microseconds (ggml_time_us()
++                // based), not seconds -- divide, don't multiply, to log a correct ms figure. This
++                // was previously wrong (inflated the logged value by ~1e6x); it never affected the
++                // actual weighting since a systematic unit-scaling error cancels out in the ratio
++                // between domains, only the human-readable log line was nonsensical.
+                 COM_INF("CPU split calibration: device '%s' (%d threads): %.4f ms/iter, weight = %.4f\n",
+-                        ggml_backend_dev_name(dev), n_threads, t * 1000.0, weight);
++                        ggml_backend_dev_name(dev), n_threads, t / 1000.0, weight);
+             } else {
+                 COM_WRN("CPU split calibration: device '%s' produced a non-positive timing, using equal weight\n",
+                         ggml_backend_dev_name(dev));
+-- 
+2.43.0
+
diff --git a/fleet-patches/0024-tests-skip-test-cpu-device-split-on-non-Linux-platfo.patch b/fleet-patches/0024-tests-skip-test-cpu-device-split-on-non-Linux-platfo.patch
new file mode 100644
index 0000000000..f8c9d0a0b4
--- /dev/null
+++ b/fleet-patches/0024-tests-skip-test-cpu-device-split-on-non-Linux-platfo.patch
@@ -0,0 +1,71 @@
+From 15c56e32caa28628c0d0a4c170826f46fdae276c Mon Sep 17 00:00:00 2001
+From: dgabehar <dgabehar@gmail.com>
+Date: Wed, 23 Sep 2026 16:24:44 -0500
+Subject: [PATCH] tests: skip test-cpu-device-split on non-Linux platforms
+
+Windows CI failed to compile this test: unistd.h, sys/stat.h's mkdir,
+and setenv are all POSIX-only. Swapping in portable equivalents isn't
+enough on its own though -- the code under test,
+ggml_backend_cpu_detect_locality_domains() (ggml/src/ggml-cpu/ggml-cpu.cpp),
+is itself #ifdef __linux__-gated and always returns the N=1 fallback on
+any other platform regardless of GGML_CPU_LOCALITY_SYSFS_ROOT. This
+test's N=2 mocked-fixture assertions could never pass on Windows even
+with a portable POSIX shim, since the feature it exercises reads a
+Linux-only sysfs tree. Skip the whole thing (build and run) outside
+Linux instead of porting code toward an assertion that would just fail
+a different way.
+
+Found and fixed incidentally while investigating unrelated CI failures
+on PR #5 (K2-Horizon EOG/reasoning-tag fixes) -- this file was untouched
+by that PR; confirmed unrelated by content inspection before digging in.
+
+Assisted-by: Claude Sonnet
+(cherry picked from commit 5e093a4d3419e06f2ae94207933757888156a191)
+---
+ tests/test-cpu-device-split.cpp | 25 ++++++++++++++++++++++++-
+ 1 file changed, 24 insertions(+), 1 deletion(-)
+
+diff --git a/tests/test-cpu-device-split.cpp b/tests/test-cpu-device-split.cpp
+index 5b374d4dd9..0015333646 100644
+--- a/tests/test-cpu-device-split.cpp
++++ b/tests/test-cpu-device-split.cpp
+@@ -11,8 +11,20 @@
+ #include "ggml-cpu.h"
+ #include "ggml-backend.h"
+ 
+-#include <cassert>
+ #include <cstdio>
++
++// The fixture below mocks a Linux sysfs tree (/sys/devices/system/cpu/.../
++// cache/index3/shared_cpu_list) and relies on setenv() + POSIX mkdir() to
++// build it. The detection code it exercises,
++// ggml_backend_cpu_detect_locality_domains() in ggml/src/ggml-cpu/ggml-cpu.cpp,
++// is itself #ifdef __linux__-gated -- on any other platform it always
++// returns the N=1 fallback regardless of GGML_CPU_LOCALITY_SYSFS_ROOT, so
++// this test's N=2 assertions could never pass there even with a portable
++// mkdir/setenv shim. Skip the whole thing outside Linux rather than porting
++// code that would just fail a different way.
++#ifdef __linux__
++
++#include <cassert>
+ #include <cstdlib>
+ #include <cstring>
+ #include <string>
+@@ -138,3 +150,14 @@ int main() {
+     printf("PASS: 2-domain mocked fixture -> 2 CPU devices, disjoint 4-core masks, both constructible\n");
+     return 0;
+ }
++
++#else // !__linux__
++
++int main() {
++    printf("SKIP: CPU locality-domain split fixture is Linux-only (sysfs-based); "
++           "ggml_backend_cpu_detect_locality_domains() always returns the N=1 "
++           "fallback on this platform, so there is nothing this test can exercise here\n");
++    return 0;
++}
++
++#endif // __linux__
+-- 
+2.43.0
+
diff --git a/fleet-patches/0025-tests-fix-stale-expected-output-in-the-shorthand-cla.patch b/fleet-patches/0025-tests-fix-stale-expected-output-in-the-shorthand-cla.patch
new file mode 100644
index 0000000000..1660598cb5
--- /dev/null
+++ b/fleet-patches/0025-tests-fix-stale-expected-output-in-the-shorthand-cla.patch
@@ -0,0 +1,68 @@
+From e3089ca400c04c1f4ef8db23c8822dc4f68b4d7d Mon Sep 17 00:00:00 2001
+From: dgabehar <dgabehar@gmail.com>
+Date: Wed, 23 Sep 2026 16:24:58 -0500
+Subject: [PATCH] tests: fix stale expected output in the shorthand-class
+ regexp test
+
+"regexp with unsupported shorthand" used \w as its example of an
+unsupported PCRE shorthand class, asserting the whole pattern falls
+back to a generic string acceptor. That assumption predates
+get_shorthand_class() in json-schema-to-grammar.cpp, which now fully
+supports \d/\D/\w/\W/\s/\S as composable grammar tokens (see that
+function's own comment) -- \w in "^[0-9]{3}\w$" is no longer
+unsupported at all, so the actual output is now a correct, fully
+expanded per-character grammar, not the stale expected fallback. This
+was an intentional behavior improvement from an earlier patch that
+never got this pre-existing test's expectation updated to match,
+causing a hard assert(false) abort on every CI run (test-json-schema-
+to-grammar.cpp:39) rather than a soft mismatch.
+
+Fixed by swapping \w for \b (word-boundary assertion): a zero-width
+construct with no GBNF equivalent, confirmed still genuinely
+unsupported (gbnf_escape_length() doesn't recognize it, so it falls
+through to unsupported_pattern). This keeps testing what the test's
+own comment says it's for -- that a partial conversion's intermediate
+rule doesn't leak into the grammar when the pattern is abandoned and
+the whole thing falls back to the generic string acceptor -- without
+asserting something the converter can actually do correctly today.
+
+Found and fixed incidentally while investigating unrelated CI failures
+on PR #5 (K2-Horizon EOG/reasoning-tag fixes) -- reproduced locally
+(exit 134, SIGABRT) before making any change, confirmed unrelated to
+that PR's 2 files by content inspection.
+
+Assisted-by: Claude Sonnet
+(cherry picked from commit 840ee5bfd1c0e92479e478f7b1dd5aa412d3bf37)
+---
+ tests/test-json-schema-to-grammar.cpp | 10 ++++++++--
+ 1 file changed, 8 insertions(+), 2 deletions(-)
+
+diff --git a/tests/test-json-schema-to-grammar.cpp b/tests/test-json-schema-to-grammar.cpp
+index d5873c19d0..6a745629ca 100755
+--- a/tests/test-json-schema-to-grammar.cpp
++++ b/tests/test-json-schema-to-grammar.cpp
+@@ -1460,13 +1460,19 @@ static void test_all(const std::string & title, std::function<void(const TestCas
+         )"""
+     });
+ 
+-    // the rules of the partial conversion (here "root-0") must not leak into the grammar
++    // \w/\d/\s (and their negations) are now fully supported shorthand classes (see
++    // get_shorthand_class() in json-schema-to-grammar.cpp) -- \b (word-boundary
++    // assertion, a zero-width construct with no GBNF equivalent) is not, so it's
++    // used here instead to keep exercising this case: the rules of the partial
++    // conversion (here "root-0"/"root-1") must not leak into the grammar when the
++    // pattern is abandoned partway through and the whole thing falls back to the
++    // generic string acceptor.
+     test({
+         SUCCESS,
+         "regexp with unsupported shorthand",
+         R"""({
+             "type": "string",
+-            "pattern": "^[0-9]{3}\\w$"
++            "pattern": "^[0-9]{3}\\b$"
+         })""",
+         R"""(
+             char ::= [^"\\\x7F\x00-\x1F] | [\\] (["\\bfnrt] | "u" [0-9a-fA-F]{4})
+-- 
+2.43.0
+
diff --git a/fleet-patches/0026-tests-loosen-slot-action-timeout-test-s-join-timeout.patch b/fleet-patches/0026-tests-loosen-slot-action-timeout-test-s-join-timeout.patch
new file mode 100644
index 0000000000..de1f541cfd
--- /dev/null
+++ b/fleet-patches/0026-tests-loosen-slot-action-timeout-test-s-join-timeout.patch
@@ -0,0 +1,67 @@
+From d87cfc01c481bc7842132d98163d16d1a9ea13af Mon Sep 17 00:00:00 2001
+From: dgabehar <dgabehar@gmail.com>
+Date: Wed, 23 Sep 2026 16:44:14 -0500
+Subject: [PATCH] tests: loosen slot-action-timeout test's join timeout margin
+
+test_slot_action_timeout_returns_error_instead_of_hanging's background
+"keep busy" thread has its own 60s HTTP request timeout, but the test
+only joined it with a 30s timeout -- tighter than the request it's
+waiting on. Under real CI parallelism (pytest-xdist running several
+other CPU-heavy completions concurrently) an 8000-token generation can
+legitimately take 30-60+ wall-clock seconds, failing the join on
+timing alone with no real regression. Observed live: CI failure with
+the busy thread still alive after the 30s join while several sibling
+tests logged 7-14s call times each in the same worker pool.
+
+Bumped the busy request's own timeout to 90s and the join to 100s
+(comfortably past it) for real margin under contention. The actual
+behavior under test -- the save action failing fast, bounded by
+slot_action_timeout_ms -- is unchanged; only the unrelated busy
+thread's generous margin changed.
+
+Found and fixed incidentally while investigating unrelated CI failures
+on PR #5 (K2-Horizon EOG/reasoning-tag fixes) -- this file is untouched
+by that PR's own 2 commits; confirmed unrelated by content and log
+inspection (assertion was `assert not t.is_alive()`, a threading/timing
+check, not anything related to vocab or chat-template code).
+
+Assisted-by: Claude Sonnet
+(cherry picked from commit d3837b2050702ab6e60e0ab71134fc8e99f8732c)
+---
+ tools/server/tests/unit/test_slot_save.py | 13 ++++++++++---
+ 1 file changed, 10 insertions(+), 3 deletions(-)
+
+diff --git a/tools/server/tests/unit/test_slot_save.py b/tools/server/tests/unit/test_slot_save.py
+index 9b39acb6b9..1240a459e2 100644
+--- a/tools/server/tests/unit/test_slot_save.py
++++ b/tools/server/tests/unit/test_slot_save.py
+@@ -254,7 +254,7 @@ def test_slot_action_timeout_returns_error_instead_of_hanging():
+             "prompt": "Tell me a very long, very detailed story about dragons:",
+             "n_predict": 8000,
+             "id_slot": 0,
+-        }, timeout=60)
++        }, timeout=90)
+         busy["status_code"] = r.status_code
+     t = threading.Thread(target=keep_slot_busy)
+     t.start()
+@@ -270,8 +270,15 @@ def test_slot_action_timeout_returns_error_instead_of_hanging():
+     assert "timed out" in save_res.body["error"]["message"].lower()
+     assert elapsed < 10  # must fail fast (bounded by slot_action_timeout_ms), not hang
+ 
+-    # the cancelled save must not have disturbed the real, unrelated busy completion
+-    t.join(timeout=30)
++    # the cancelled save must not have disturbed the real, unrelated busy completion.
++    # join timeout must exceed keep_slot_busy()'s own request timeout above (90s) --
++    # it was previously 30s, tighter than the busy request's own 60s HTTP timeout, so
++    # under real CI parallelism (pytest-xdist running several other CPU-heavy
++    # completions concurrently) an 8000-token generation legitimately taking
++    # 30-60+ wall-clock seconds would fail this join on timing alone, unrelated to
++    # any real regression (observed live: CI failure with the busy thread still
++    # alive after 30s while several sibling tests logged 7-14s call times each).
++    t.join(timeout=100)
+     assert not t.is_alive()
+     assert busy.get("status_code") == 200
+ 
+-- 
+2.43.0
+
diff --git a/fleet-patches/0027-rpc-serve-each-client-connection-on-its-own-thread.patch b/fleet-patches/0027-rpc-serve-each-client-connection-on-its-own-thread.patch
new file mode 100644
index 0000000000..1ae23ca414
--- /dev/null
+++ b/fleet-patches/0027-rpc-serve-each-client-connection-on-its-own-thread.patch
@@ -0,0 +1,50 @@
+From 66de0db9e7383be1972e42ee075d1439fb12b9d3 Mon Sep 17 00:00:00 2001
+From: Shikanime Deva <william.phetsinorath@shikanime.studio>
+Date: Mon, 14 Sep 2026 22:12:35 +0200
+Subject: [PATCH] rpc : serve each client connection on its own thread
+MIME-Version: 1.0
+Content-Type: text/plain; charset=UTF-8
+Content-Transfer-Encoding: 8bit
+
+ggml_backend_rpc_start_server serves clients from a single accept loop: it
+accepts one socket, runs rpc_serve_client to completion, then accepts the
+next. In router mode each model child holds a long-lived RPC connection for
+the model's lifetime, so the first loaded model permanently occupies the
+loop and every later model starves in the kernel accept backlog — its
+HELLO is never answered and the child blocks in recv(8) forever. Any
+second long-lived connection wedges; it only looks MoE-shaped because a
+dense model usually loads first.
+
+Serve each connection on its own detached thread. rpc_server is already
+constructed per connection inside rpc_serve_client, so per-connection state
+is isolated; the shared backends handles are the same objects the serial
+loop already used. Verified with a two-client repro: client A holds its
+connection, client B's HELLO returns in 0.00s with this change and never
+returns before it.
+
+Signed-off-by: Shikanime Deva <william.phetsinorath@shikanime.studio>
+(cherry picked from commit 414817e1648d86561103f0de4572b1ad1c9ba268)
+---
+ ggml/src/ggml-rpc/ggml-rpc.cpp | 6 ++++--
+ 1 file changed, 4 insertions(+), 2 deletions(-)
+
+diff --git a/ggml/src/ggml-rpc/ggml-rpc.cpp b/ggml/src/ggml-rpc/ggml-rpc.cpp
+index e9af71228e..f331c8822c 100644
+--- a/ggml/src/ggml-rpc/ggml-rpc.cpp
++++ b/ggml/src/ggml-rpc/ggml-rpc.cpp
+@@ -2713,8 +2713,10 @@ void ggml_backend_rpc_start_server(const char * endpoint, const char * cache_dir
+         }
+         printf("Accepted client connection\n");
+         fflush(stdout);
+-        rpc_serve_client(backends, cache_dir, client_socket);
+-        printf("Client connection closed\n");
++        std::thread([backends, cache_dir, client_socket]() {
++            rpc_serve_client(backends, cache_dir, client_socket);
++        }).detach();
++        printf("Client connection accepted for serving\n");
+         fflush(stdout);
+     }
+     rpc_transport_shutdown();
+-- 
+2.43.0
+
diff --git a/fleet-patches/0028-rpc-serialize-backend-compute-across-connection-thre.patch b/fleet-patches/0028-rpc-serialize-backend-compute-across-connection-thre.patch
new file mode 100644
index 0000000000..3a5c0007ca
--- /dev/null
+++ b/fleet-patches/0028-rpc-serialize-backend-compute-across-connection-thre.patch
@@ -0,0 +1,48 @@
+From c75c3cd6c717836cc05cb0776828bc6ab69cbe28 Mon Sep 17 00:00:00 2001
+From: Shikanime Deva <william.phetsinorath@shikanime.studio>
+Date: Fri, 18 Sep 2026 13:42:52 +0200
+Subject: [PATCH] rpc : serialize backend compute across connection threads
+
+Concurrent connections can now drive the same backend handle. Restores
+the pre-fix serialization semantics around ggml_backend_graph_compute
+with a single file-scope mutex shared by graph_compute and
+graph_recompute.
+
+Signed-off-by: Shikanime Deva <william.phetsinorath@shikanime.studio>
+(cherry picked from commit 5bacb855d2e3e07acc6910d149af76f9765f0d84)
+---
+ ggml/src/ggml-rpc/ggml-rpc.cpp | 4 ++++
+ 1 file changed, 4 insertions(+)
+
+diff --git a/ggml/src/ggml-rpc/ggml-rpc.cpp b/ggml/src/ggml-rpc/ggml-rpc.cpp
+index f331c8822c..e828bbf6f4 100644
+--- a/ggml/src/ggml-rpc/ggml-rpc.cpp
++++ b/ggml/src/ggml-rpc/ggml-rpc.cpp
+@@ -2006,6 +2006,8 @@ ggml_tensor * rpc_server::create_node(uint64_t id,
+     return result;
+ }
+ 
++static std::mutex compute_mutex; // serializes backend compute across connection threads
++
+ bool rpc_server::graph_compute(const std::vector<uint8_t> & input) {
+     // serialization format:
+     // | device (4 bytes) | uid (8 bytes) | n_nodes (4 bytes) | nodes (n_nodes * sizeof(uint64_t) | n_tensors (4 bytes) | tensors (n_tensors * sizeof(rpc_tensor)) |
+@@ -2083,6 +2085,7 @@ bool rpc_server::graph_compute(const std::vector<uint8_t> & input) {
+             graph->use_counts[hash_pos] = tensor_ptrs.at(id)->use_count;
+         }
+     }
++    std::lock_guard<std::mutex> lock(compute_mutex);
+     ggml_status status = ggml_backend_graph_compute_async(backends[device], graph);
+     GGML_ASSERT(status == GGML_STATUS_SUCCESS && "Unsuccessful graph computations are not supported with RPC");
+     sg.graph = graph;
+@@ -2101,6 +2104,7 @@ bool rpc_server::graph_recompute(const rpc_msg_graph_recompute_req & request) {
+     }
+     ggml_cgraph * graph = it->second.graph;
+     LOG_DBG("[%s] device: %u, uid: %" PRIu64 "\n", __func__, device, request.uid);
++    std::lock_guard<std::mutex> lock(compute_mutex);
+     ggml_status status = ggml_backend_graph_compute_async(backends[device], graph);
+     GGML_ASSERT(status == GGML_STATUS_SUCCESS && "Unsuccessful graph computations are not supported with RPC");
+     return true;
