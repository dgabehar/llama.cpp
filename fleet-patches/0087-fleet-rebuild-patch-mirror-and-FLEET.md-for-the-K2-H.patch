++        }
++
+         switch (task.type) {
+             case SERVER_TASK_TYPE_COMPLETION:
+             case SERVER_TASK_TYPE_INFILL:
+@@ -3350,7 +3372,9 @@ private:
+                     off_next = off + n_tokens;
+ 
+                     if (ckpt_capture) {
