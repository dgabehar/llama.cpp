++                } else if (v == "1" || v == "true" || v == "on" || v == "yes") {
++                    ckpt_capture = params_base.n_ctx_checkpoints > 0 && !has_eagle3;
+                 }
+             }
+ 
+@@ -2774,6 +2791,11 @@ private:
+             return false;
+         }
+ 
++        // a task may launch, save or restore a slot, which uses its checkpoints
