diff --git a/fleet-patches/0065-chat-drop-whitespace-between-reasoning-end-tag-and-c.patch b/fleet-patches/0065-chat-drop-whitespace-between-reasoning-end-tag-and-c.patch
new file mode 100644
index 0000000000..11d5abf209
--- /dev/null
+++ b/fleet-patches/0065-chat-drop-whitespace-between-reasoning-end-tag-and-c.patch
@@ -0,0 +1,63 @@
+From b95797a748e3823430905e81162f5e061924065c Mon Sep 17 00:00:00 2001
+From: dgabehar <dgabehar@gmail.com>
+Date: Fri, 25 Sep 2026 17:18:13 -0500
+Subject: [PATCH] chat : drop whitespace between reasoning end tag and content
+
+K2-Horizon (and any other tag-based reasoning model) can leave a plain
+formatting newline right after its reasoning close tag, most visibly
+when the reasoning block itself is empty at low effort. The generated
+PEG parser had nothing consuming that gap: analyze_content::build_parser
+went straight from the reasoning parser's closer into the content
+capture, so the newline landed at the front of "content" instead of
+being dropped like the whitespace already discarded from a
+whitespace-only reasoning_content.
+
+Reproduced live: 2/10 requests to K2-Horizon-7B (reasoning_effort low,
+reasoning_format auto) returned content starting with "\n". The other
+8/10 returned correct content, some prefixed with the model's own ": "
+text, which must not be stripped.
+
+Fix: consume optional whitespace with p.space() right after the
+reasoning parser, before content starts -- the same pattern already
+used for the JSON response-format path in build_parser. Applied to
+both analyze_content::build_parser branches (always-wrapped and
+stray-ends), gated on ctx.extracting_reasoning so a model with no
+reasoning tags at all keeps any leading whitespace it genuinely emits.
+
+Added test-chat.cpp cases: empty reasoning + newline, empty reasoning +
+": " (must be preserved), non-empty reasoning + double newline. Live
+recheck after the fix: 0/10 leading-whitespace content.
+
+Assisted-by: Claude Sonnet 5
+(cherry picked from commit 599dd43b0edefced31b94ace3e5cc34dce838077)
+---
+ common/chat-auto-parser-generator.cpp | 10 +++++++++-
+ 1 file changed, 9 insertions(+), 1 deletion(-)
+
+diff --git a/common/chat-auto-parser-generator.cpp b/common/chat-auto-parser-generator.cpp
+index b78789d8c0..f929546445 100644
+--- a/common/chat-auto-parser-generator.cpp
++++ b/common/chat-auto-parser-generator.cpp
+@@ -161,10 +161,18 @@ common_peg_parser analyze_content::build_parser(parser_build_context & ctx) cons
+ 
+     if (is_always_wrapped()) {
+         if (ctx.extracting_reasoning) {
+-            return ctx.reasoning_parser + start + p.content(p.until(end)) + end + p.end();
++            // p.space() drops any whitespace the model leaves between the reasoning end tag
++            // and the content start tag (e.g. an empty K2-Horizon reasoning block followed by
++            // a formatting newline) so it never lands at the front of content.
++            return ctx.reasoning_parser + p.space() + start + p.content(p.until(end)) + end + p.end();
+         }
+         return p.content(p.until(start)) + start + p.content(p.until(end)) + end + p.end();
+     }
++    if (ctx.extracting_reasoning) {
++        // Drop whitespace between the reasoning end tag and the content, only when reasoning was
++        // actually parsed out, so a model with no reasoning tags keeps any leading whitespace it emits.
++        return ctx.reasoning_parser + p.space() + p.content(p.rest()) + p.end();
++    }
+     return ctx.reasoning_parser + p.content(p.rest()) + p.end();
+ }
+ 
+-- 
+2.43.0
+
diff --git a/fleet-patches/0066-llama-common-fix-fit-s-oversized-context-probe-hard-.patch b/fleet-patches/0066-llama-common-fix-fit-s-oversized-context-probe-hard-.patch
new file mode 100644
index 0000000000..735daa9f39
--- /dev/null
+++ b/fleet-patches/0066-llama-common-fix-fit-s-oversized-context-probe-hard-.patch
@@ -0,0 +1,150 @@
+From f4bd6113a5dce777a0fb754d4a003c10988ee49c Mon Sep 17 00:00:00 2001
+From: dgabehar <dgabehar@gmail.com>
+Date: Fri, 25 Sep 2026 18:31:47 -0500
+Subject: [PATCH] llama, common: fix -fit's oversized-context probe
+ hard-aborting the server
+
+llama-server crashed on plain default startup (-m K2-Horizon-7B... --jinja
+-c 8192, no special flags) on a laptop with an RTX 3080 Ti + an Intel iGPU.
+Not actually about two GPUs being visible: reproduced identically with
+--device Vulkan1 alone, and this fork's device selection already drops the
+iGPU whenever a discrete GPU is present, so K2-Horizon-7B was already
+running on the 3080 Ti alone either way.
+
+Root cause: llama-server's n_parallel=auto picked 4, and K2-Horizon-7B's
+native n_ctx_train is 524288, so --fit's own auto-context measurement
+probed at 524288 * 4 = 2097152. With kv_unified, layer 0's K cache tensor
+at that size is 1024 * 2097152 * 2 bytes = 4294967296 -- exactly one byte
+over Vulkan's maxStorageBufferRange (4294967295 on this GPU).
+ggml_backend_vk_device_supports_op correctly rejects the op for being
+oversized, ggml_backend_sched_backend_id_from_cur then finds no backend
+willing to run it, and hits the "pre-allocated tensor ... that cannot run
+the operation" GGML_ABORT -- a hard process abort, not a catchable error,
+the first time that KV cache tensor is scheduled. Traced live with gdb:
+ggml_backend_supports_buft returns true for the GPU backend,
+ggml_backend_supports_op is what returns false. Same mechanism would hit
+any backend with a per-op size ceiling and any model whose
+n_ctx_train * n_parallel crosses it.
+
+Fixed two places:
+- src/llama-kv-cache.cpp: check ggml_backend_dev_supports_op on each
+  layer's K/V tensor right after creating it, before it becomes a
+  pre-allocated leaf the scheduler can hard-abort on. Throws a normal,
+  descriptive std::runtime_error instead, which llama_init_from_model's
+  existing try/catch already logs and turns into a clean nullptr return.
+- common/fit.cpp: common_params_fit_impl's auto-context measurement
+  (n_ctx_auto && n_seq_max > 1) now catches that failure and backs off
+  geometrically (halving, floored at n_ctx_min_total) until the probe
+  succeeds, so --fit actually finds a working context size instead of
+  just failing to start.
+
+Verified live on the affected hardware: K2-Horizon-7B and Qwen3.5-4B both
+start clean on default flags (no -c, no --device, no -fit off) and serve a
+real chat completion. K2-Horizon-7B's probe logs one backoff (2097152 ->
+1048576) and settles on a real n_ctx sized by the existing free-memory-
+margin logic, unchanged. ctest -L main (59/59) and ctest -R split-balance
+(1/1) both pass.
+
+No new automated regression test: the trigger is a real per-op device
+byte-size ceiling (Vulkan's maxStorageBufferRange) that the CPU backend
+used by the existing CPU-only test infra in tests/test-split-balance.cpp
+does not enforce, so exercising it without new mock-backend
+infrastructure or real GPU hardware isn't possible; verification is the
+live repro/fix run above.
+
+Assisted-by: Claude Sonnet 5
+(cherry picked from commit d260d6288224a059cc5ca3f4028dbccd15c30ae7)
+---
+ common/fit.cpp         | 26 ++++++++++++++++++++++++--
+ src/llama-kv-cache.cpp | 22 +++++++++++++++++++++-
+ 2 files changed, 45 insertions(+), 3 deletions(-)
+
+diff --git a/common/fit.cpp b/common/fit.cpp
+index b47ebcdd29..75c85f604f 100644
+--- a/common/fit.cpp
++++ b/common/fit.cpp
+@@ -330,7 +330,7 @@ static void common_params_fit_impl(
+     dmds_t dmds_full = common_get_device_memory_data_impl(path_model, mparams, cparams, devs, hp_ngl, hp_nct, hp_nex, log_level);
+ 
+     // saturate instead of overflowing, this also preserves the UINT32_MAX sentinel of n_ctx_min:
+-    const uint32_t n_ctx_max       = (uint32_t) std::min<uint64_t>(uint64_t(hp_nct)    * n_streams, UINT32_MAX);
++    uint32_t       n_ctx_max       = (uint32_t) std::min<uint64_t>(uint64_t(hp_nct)    * n_streams, UINT32_MAX);
+     const uint32_t n_ctx_min_total = (uint32_t) std::min<uint64_t>(uint64_t(n_ctx_min) * n_streams, UINT32_MAX);
+ 
+     // llama_context would use only hp_nct in total for n_ctx == 0, resolve the context before measuring anything else:
+@@ -339,7 +339,29 @@ static void common_params_fit_impl(
+         if (n_streams > 1) {
+             LOG_TRC("%s: context size unset and KV cache not unified -> using %" PRIu32 " for %" PRIu32 " sequences:\n",
+                 __func__, n_ctx_max, n_streams);
+-            dmds_full = common_get_device_memory_data_impl(path_model, mparams, cparams, devs, hp_ngl, hp_nct, hp_nex, log_level);
++            // a context this large can produce a per-layer KV cache tensor too large for a
++            // device to run an op against (e.g. Vulkan's maxStorageBufferRange) even when it
++            // would otherwise fit in free memory -- llama_init_from_model() catches that and
++            // returns nullptr, which common_get_device_memory_data_impl() turns into this
++            // exception. Back off geometrically until the probe actually succeeds instead of
++            // letting an oversized probe abort llama_params_fit entirely.
++            for (;;) {
++                try {
++                    dmds_full = common_get_device_memory_data_impl(path_model, mparams, cparams, devs, hp_ngl, hp_nct, hp_nex, log_level);
++                    break;
++                } catch (const std::runtime_error & e) {
++                    if (cparams->n_ctx <= n_ctx_min_total) {
++                        throw;
++                    }
++                    const uint32_t n_ctx_prev = cparams->n_ctx;
++                    cparams->n_ctx = std::max(n_ctx_min_total, cparams->n_ctx / 2);
++                    LOG_WRN("%s: failed to probe device memory at n_ctx = %" PRIu32 ", retrying at %" PRIu32 ": %s\n",
++                        __func__, n_ctx_prev, cparams->n_ctx, e.what());
++                }
++            }
++            // the probe may have had to back off below the originally requested max, use
++            // whatever size actually worked as the new ceiling for the rest of this function:
++            n_ctx_max = cparams->n_ctx;
+         }
+     }
+     add_extra_memory(dmds_full);
+diff --git a/src/llama-kv-cache.cpp b/src/llama-kv-cache.cpp
+index 463510caa7..c4b6b23fcf 100644
+--- a/src/llama-kv-cache.cpp
++++ b/src/llama-kv-cache.cpp
+@@ -212,9 +212,10 @@ llama_kv_cache::llama_kv_cache(
+         const char * dev_name = "CPU";
+ 
+         ggml_backend_buffer_type_t buft = ggml_backend_cpu_buffer_type();
++        ggml_backend_dev_t dev = nullptr;
+ 
+         if (offload) {
+-            auto * dev = model.dev_layer(il);
++            dev = model.dev_layer(il);
+             buft = ggml_backend_dev_buffer_type(dev);
+ 
+             dev_name = ggml_backend_dev_name(dev);
+@@ -236,6 +237,25 @@ llama_kv_cache::llama_kv_cache(
+         has_k && ggml_format_name(k, "cache_%sk_l%d", name_tag, il);
+         has_v && ggml_format_name(v, "cache_%sv_l%d", name_tag, il);
+ 
++        // a KV cache tensor this large is pre-allocated (its buffer is set below), so if the
++        // device can't actually run an op against it (e.g. it exceeds a Vulkan device's
++        // maxStorageBufferRange), ggml_backend_sched would otherwise hard-abort deep inside
++        // graph_reserve() the first time this layer's cache is scheduled. Catch it here instead,
++        // as a normal exception the caller (e.g. --fit's own oversized context probe) can recover
++        // from by trying a smaller context size.
++        if (dev != nullptr) {
++            if (k != nullptr && !ggml_backend_dev_supports_op(dev, k)) {
++                throw std::runtime_error(format(
++                        "kv cache: layer %d K cache (%s, %zu MiB) is too large for device %s to operate on -- try a smaller context size",
++                        il, ggml_type_name(type_k), ggml_nbytes(k)/1024/1024, dev_name));
++            }
++            if (v != nullptr && !ggml_backend_dev_supports_op(dev, v)) {
++                throw std::runtime_error(format(
++                        "kv cache: layer %d V cache (%s, %zu MiB) is too large for device %s to operate on -- try a smaller context size",
++                        il, ggml_type_name(type_v), ggml_nbytes(v)/1024/1024, dev_name));
++            }
++        }
++
+         std::vector<ggml_tensor *> k_stream;
+         std::vector<ggml_tensor *> v_stream;
+ 
+-- 
+2.43.0
+
diff --git a/fleet-patches/0067-common-size-fit-s-auto-context-probe-from-measured-f.patch b/fleet-patches/0067-common-size-fit-s-auto-context-probe-from-measured-f.patch
new file mode 100644
index 0000000000..64c45afa39
--- /dev/null
+++ b/fleet-patches/0067-common-size-fit-s-auto-context-probe-from-measured-f.patch
@@ -0,0 +1,363 @@
+From 98685de0f080542fa68b066223e70cfa56353f5e Mon Sep 17 00:00:00 2001
+From: dgabehar <dgabehar@gmail.com>
+Date: Fri, 25 Sep 2026 21:15:06 -0500
+Subject: [PATCH] common: size -fit's auto-context probe from measured free
+ memory, not just a caught exception
+
+70f0d0168 made -fit catch the KV-cache-tensor-too-large exception
+(ggml_backend_dev_supports_op rejecting an oversized per-op tensor,
+e.g. Vulkan's maxStorageBufferRange) and back off geometrically. That
+covers a discrete GPU with a low per-op ceiling but no other memory
+surprises. On a UMA device the per-op check is not the problem: each
+layer's K/V tensor can pass it individually while the KV cache still
+adds up to more real memory than the device can back once actually
+allocated and zero-initialized.
+
+Reproduced locally on this workstation's Intel UHD 770 iGPU (Vulkan,
+UMA -- same class of device as the gfx90c/680M this was found on,
+per QA round 8 section R1b): K2-Horizon-7B with no -c, so llama-server
+uses its huge native n_ctx_train (524288) times n_parallel=auto. The
+existing fix's per-op check does reject the first probe (2097152) and
+backs off once to 1048576, exactly as designed -- and that is where it
+stops, because backing off further needs a second failure to catch,
+and none was thrown. At that size the real KV-cache buffer is nominally
+allocated fine, but zero-initializing it (llama-kv-cache.cpp's
+ggml_backend_buffer_clear right after allocation) touches pages the
+device can't really back. On this UMA backend a host-visible buffer's
+clear is a plain CPU memset (ggml_vk_buffer_memset), so the failure
+surfaces as the kernel's own page-fault path spinning forever
+(dmesg floods with "VM_FAULT_OOM leaked out to the #PF handler",
+never terminating -- worse than a crash, no graceful anything). QA's
+report of the same bug on gfx90c hit the GPU-fillBuffer variant of the
+same clear operation instead, surfacing as a real vk::DeviceLostError
+during command submission. Same root cause, two different failure
+shapes depending on whether the backend's buffer-clear path happens to
+be host-visible-and-UMA or not; neither is something a per-op support
+check could ever catch, because the tensor itself was never the
+problem.
+
+Fix (option a from the brief): before the auto-context probe ever
+tries the full n_ctx_max, take one cheap real measurement at
+n_ctx_min_total (always small enough to be safe) to get a real
+bytes-per-ctx figure, then clamp the probe so projected KV-cache use
+stays inside each device's free memory minus its existing --fit
+margin -- the same free-memory accounting the rest of this function
+already does further down for its own post-probe sizing, just applied
+before building anything instead of after a failure. For an
+integrated/UMA device, also cap its free-memory figure by the host's
+own reported free bytes: a UMA device's GTT pool is carved from host
+RAM, and (per this fleet's own prior finding on AMD APUs) its "free"
+figure is not guaranteed to reflect what every other process on the
+host is actually holding. The existing per-op-exception backoff loop
+is kept, unchanged, as defense in depth for whatever the linear
+estimate misses -- it is a linear extrapolation off one small
+measurement, not exact.
+
+Options b and c from the brief were considered and not used as the
+fix. (b): the probe path does not actually need to stop submitting
+GPU work, because it already does not -- llama_model_params.no_alloc
+routes llama-kv-cache.cpp to a dummy 0-byte buffer during a measurement
+pass, skipping both the real allocation and the clear. The clear that
+actually crashes runs during the real (post-fit) load, which every
+device has to do regardless of --fit; there is nothing to remove
+there. (c): making the Vulkan backend turn a submit failure into a
+catchable error only helps the gfx90c shape. It does nothing for the
+Intel iGPU shape reproduced here, which is a kernel-level page-fault
+stall inside a plain CPU memset, not a C++ exception anything in
+ggml-vulkan.cpp is on the stack for. ggml-vulkan.cpp already logs and
+rethrows vk::DeviceLostError from its own submit paths (see
+ggml_vk_wait_for_fence, vk_queue_handle_*::submit), which is sufficient
+existing defense in depth for that one shape.
+
+Out of scope: the n_ctx_auto && n_seq_max == 1 case (--parallel 1, no
+multiplier) runs its one and only probe with zero exception protection
+at all -- not new, not touched here, and not what the reported bug or
+its verification exercise. Restructuring that would need querying a
+model's n_ctx_train before ever building a context at all, a bigger
+change than this fix's scope.
+
+Verification (workstation only, per the session's hard rule against
+touching cluster nodes after an earlier node-crash incident this
+session -- every run below wrapped in
+`systemd-run --scope -p MemoryMax=10G -p MemorySwapMax=0`, one process
+at a time, `free -g` checked before each):
+- Before this commit, on the Intel UHD 770 iGPU: K2-Horizon-7B with no
+  -c backs off once (2097152 -> 1048576) exactly as 70f0d0168 intends,
+  then hangs forever with dmesg flooding "VM_FAULT_OOM leaked out to
+  the #PF handler" (310+ lines/5s) instead of crashing or recovering.
+  Killed by PID after capturing the log.
+- After this commit, same case, same cap: logs
+  "clamping the auto-context probe from 2097152 to 13863", loads
+  cleanly, and serves a real /v1/chat/completions request
+  (n_ctx_slot=13312 across 4 slots). The 10G cap needed a matching
+  -fitt/--fit-target margin (13000 MiB) to reflect this test's actual
+  memory ceiling, because the clamp trusts the device's own reported
+  free memory (~19-20 GiB, unaffected by this process's own cgroup) --
+  the same way a real deployment sizes -fitt from its container's
+  actual memory limit.
+- Explicit -c 8192 (same model, same cap): identical before and after
+  this commit -- no clamp log line (the new code is gated on
+  n_ctx_auto, which -c disables), n_ctx_slot=8192 exactly as requested,
+  serves a real completion.
+- Could not verify the original 70f0d0168 NVIDIA RTX 3080 Ti case in
+  this session: nvidia-smi and Vulkan both report no NVIDIA device
+  available (driver not loaded in this sandboxed session). The fix
+  does not touch src/llama-kv-cache.cpp or the per-op exception path
+  70f0d0168 added, so that regression test is structurally unaffected
+  by this change; this is not a substitute for actually running it.
+- Could not re-verify on gabesrv01's real gfx90c: an earlier attempt
+  this session to reproduce this same bug there ran the node out of
+  memory (unbounded -c probe, no cap) and took gabesrv01 NotReady,
+  requiring a manual reboot. Per the coordinator's instruction after
+  that incident, no further cluster-node testing was done for this
+  fix; all verification above is workstation-only.
+- ctest -L main: 60/60 (was 59; +1 for the new test below).
+- ctest -R split-balance: 1/1.
+- Added tests/test-fit-clamp.cpp, a new test file (see AGENTS.md's
+  bar for that -- explicitly requested for this fix, and this fork's
+  own maintainer is the one asking): direct unit tests of the new
+  common_fit_clamp_ctx_to_free_memory() pure function extracted from
+  the clamp logic (no free memory, tight budget, zero bytes_per_ctx,
+  floor behavior, floor-division rounding).
+
+Assisted-by: Claude Sonnet 5
+(cherry picked from commit 442f1b2dd48b1cea181254c737e948bad4e51bf2)
+---
+ common/fit.cpp           | 78 +++++++++++++++++++++++++++++++++---
+ common/fit.h             | 18 +++++++++
+ tests/CMakeLists.txt     |  1 +
+ tests/test-fit-clamp.cpp | 85 ++++++++++++++++++++++++++++++++++++++++
+ 4 files changed, 176 insertions(+), 6 deletions(-)
+ create mode 100644 tests/test-fit-clamp.cpp
+
+diff --git a/common/fit.cpp b/common/fit.cpp
+index 75c85f604f..46810290da 100644
+--- a/common/fit.cpp
++++ b/common/fit.cpp
+@@ -22,6 +22,19 @@ void common_fit_last_graph_nodes(int32_t & pp, int32_t & tg) {
+     tg = g_last_graph_nodes_tg;
+ }
+ 
++uint32_t common_fit_clamp_ctx_to_free_memory(
++        uint32_t n_ctx_max, uint32_t n_ctx_min_total,
++        int64_t dev_free, int64_t fixed_use, int64_t margin, int64_t bytes_per_ctx) {
++    if (bytes_per_ctx <= 0) {
++        return n_ctx_max; // this device holds none of the KV cache, nothing to clamp
++    }
++    const int64_t budget = dev_free - fixed_use - margin;
++    const uint32_t n_ctx_safe = budget > 0
++        ? (uint32_t) std::min<int64_t>(n_ctx_max, budget / bytes_per_ctx)
++        : n_ctx_min_total;
++    return std::max(n_ctx_safe, n_ctx_min_total);
++}
++
+ // this enum is only used in llama_params_fit_impl but needs to be defined outside of it to fix a Windows compilation issue
+ // enum to identify part of a layer for distributing its tensors:
+ enum common_layer_fraction_t {
+@@ -339,12 +352,65 @@ static void common_params_fit_impl(
+         if (n_streams > 1) {
+             LOG_TRC("%s: context size unset and KV cache not unified -> using %" PRIu32 " for %" PRIu32 " sequences:\n",
+                 __func__, n_ctx_max, n_streams);
+-            // a context this large can produce a per-layer KV cache tensor too large for a
+-            // device to run an op against (e.g. Vulkan's maxStorageBufferRange) even when it
+-            // would otherwise fit in free memory -- llama_init_from_model() catches that and
+-            // returns nullptr, which common_get_device_memory_data_impl() turns into this
+-            // exception. Back off geometrically until the probe actually succeeds instead of
+-            // letting an oversized probe abort llama_params_fit entirely.
++
++            // A per-op size ceiling (e.g. Vulkan's maxStorageBufferRange) is not the only way
++            // building a context this large can go wrong. On a UMA device the per-layer KV
++            // cache tensors can each pass that per-op check individually and still add up to
++            // more real memory than the device can actually back -- that fails as an uncaught
++            // driver exception or a kernel-level allocation stall, neither of which is a
