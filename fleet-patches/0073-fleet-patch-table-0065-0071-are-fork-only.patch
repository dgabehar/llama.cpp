++++++++++++++++    test_cases.emplace_back(new test_mul_mat(GGML_TYPE_F32, GGML_TYPE_F32, 8, 129, 4096, {1, 1}, {1, 1}));
++++++++++++++++    test_cases.emplace_back(new test_mul_mat(GGML_TYPE_F32, GGML_TYPE_F32, 8, 65,  4096, {1, 1}, {1, 1}));
++++++++++++++++
