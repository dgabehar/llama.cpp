++++++++++++++++++                fmt == "ipv4" || fmt == "ipv6" || fmt == "uuid" ||
++++++++++++++++++                fmt.find("uuid") == 0) {
++++++++++++++++++                return true;
++++++++++++++++++            }
++++++++++++++++++        }
++++++++++++++++++
++++++++++++++++++        return false;
++++++++++++++++++    };
++++++++++++++++++
++++++++++++++++++    return check(schema);
++++++++++++++++++}
