+++ b/ggml/src/ggml-backend.cpp
@@ -2438,13 +2438,13 @@ static const struct ggml_backend_buffer_i ggml_backend_cpu_buffer_from_ptr_i = {
 
 // this buffer type is defined here to make it available to all backends
 
