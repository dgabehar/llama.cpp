diff --git a/fleet-patches/0008-ggml-add-GGML_OP_SSM_CONV_SPLIT-CPU-Vulkan-to-skip-t.patch b/fleet-patches/0008-ggml-add-GGML_OP_SSM_CONV_SPLIT-CPU-Vulkan-to-skip-t.patch
