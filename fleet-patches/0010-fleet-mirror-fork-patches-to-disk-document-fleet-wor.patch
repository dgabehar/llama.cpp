+         case GGML_OP_SSM_SCAN:
+             {
+                 ggml_compute_forward_ssm_scan(params, tensor);
+@@ -2424,6 +2428,7 @@ static int ggml_get_n_tasks(struct ggml_tensor * node, int n_threads) {
+         case GGML_OP_FLASH_ATTN_EXT:
