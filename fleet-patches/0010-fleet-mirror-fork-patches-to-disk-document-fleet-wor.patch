++        out.append("[")
++        if from_char == to_char:
++            out.append(from_char)
++        else:
++            out.append(from_char)
++            out.append("-")
++            out.append(to_char)
++        out.append("]")
++
++    def more_digits(min_digits: int, max_digits: int):
++        out.append("[0-9]")
