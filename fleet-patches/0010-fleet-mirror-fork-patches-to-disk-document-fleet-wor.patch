++                        frag_split = ref.split('#')
++                        base_url = frag_split[0]
++
++                        target = self._refs.get(base_url)
++                        if target is None:
++                            target = self.resolve_refs(requests.get(ref).json(), base_url)
++                            self._refs[base_url] = target
