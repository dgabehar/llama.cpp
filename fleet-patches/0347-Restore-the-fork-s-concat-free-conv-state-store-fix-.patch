From 7571530fa7ee35f913b9d67be887062f9a1ea08b Mon Sep 17 00:00:00 2001
From: dgabehar <dgabehar@gmail.com>
Date: Tue, 10 Nov 2026 13:50:24 -0600
Subject: [PATCH] Restore the fork's concat-free conv-state store, fix three
 more merge regressions

Found by running ctest on the 2026-11-10 upstream merge:

- delta-net-base.cpp / qwen4exp.cpp: the merge had swapped the fork's per-slot conv-window stores for upstream's build_conv_state_store(). That helper expects conv_x to be the materialized concat(history, tokens); the fork's build_conv_state/_split deliberately return {prefix, new_tokens} for ggml_ssm_conv_split and never build the concat, so the helper cut views out of a transposed tensor and hit the new GGML_ASSERT in ggml_view_impl (test-state-capture). Back to build_conv_window()/build_token_cols() as before the merge.
- peg-parser.cpp: upstream's recursion limit indexes ctx.rule_depth, which only the root parse() sizes. The K2-Horizon lenient-fallback parse in chat.cpp starts at a rule on a fresh context, so rule_depth was empty and test-chat segfaulted. The rule parser now grows rule_depth on demand.
- test-backend-ops.cpp: test_ssm_conv_split_graph viewed a transposed tensor and patched nb[0] by hand; upstream's view assert (#31584) rejects that. It now cuts the tail from the contiguous rows and transposes, like build_token_cols.
- test-llama-context.cpp: four model threads load in one process; --split-balance's default (auto) memory probe swaps the same global log callback that fit_params=false already avoids, which crashed the run. The test sets split_balance to memory.

Assisted-by: Claude Sonnet
---
 common/peg-parser.cpp         |   6 ++
 src/models/delta-net-base.cpp | 113 ++++++++++++++++++++++++++++++++--
 src/models/models.h           |  10 +++
 src/models/qwen4exp.cpp       |  31 ++++++++--
 tests/test-backend-ops.cpp    |   5 +-
 tests/test-llama-context.cpp  |   3 +
 6 files changed, 157 insertions(+), 11 deletions(-)

diff --git a/common/peg-parser.cpp b/common/peg-parser.cpp
index 534b3ea01..7971c0ca7 100644
--- a/common/peg-parser.cpp
+++ b/common/peg-parser.cpp
@@ -760,6 +760,12 @@ struct parser_executor {
     }
 
     common_peg_parse_result operator()(const common_peg_rule_parser & p) {
+        // the root parse() sizes rule_depth for the whole arena; a context that starts at a rule instead
+        // (the K2-Horizon lenient-fallback parse in chat.cpp) never went through it
+        if (ctx.rule_depth.size() <= (size_t) p.child) {
+            ctx.rule_depth.resize((size_t) p.child + 1, 0);
+        }
+
         // only rules recurse, a recursive rule is entered once per input level
         if (ctx.rule_depth[p.child] >= RULE_RECURSIVE_LIMIT) {
             throw common_peg_recursion_error("input is nested more than " + std::to_string(RULE_RECURSIVE_LIMIT) + " levels deep");
diff --git a/src/models/delta-net-base.cpp b/src/models/delta-net-base.cpp
index b841c70f9..851abdda7 100644
--- a/src/models/delta-net-base.cpp
+++ b/src/models/delta-net-base.cpp
@@ -443,6 +443,67 @@ std::pair<ggml_tensor *, ggml_tensor *> llm_build_delta_net_base::build_delta_ne
     return build_delta_net_chunking(q, k, v, g, b, s, il);
 }
 
+// Build the width-(conv_kernel_size - 1) window starting at logical column
+// `s_idx` of what used to be the materialized concat(prefix, new_tokens)
+// buffer, without materializing that full buffer. The window either falls
+// entirely inside `prefix` (s_idx == 0), entirely inside `new_tokens`
+// (s_idx >= dm1), or straddles the boundary between them (0 < s_idx < dm1) --
+// s_idx < dm1 only happens when n_t < dm1, i.e. during single/small-token
+// decode steps, since prefill's n_t is normally far larger than the conv
+// kernel width. The straddling case is the one the old concat-based code got
+// "for free"; here it costs a small (at most dm1-wide) concat instead of one
+// sized by the full n_t.
+//
+// new_tokens is a transposed view: its dim 0 (tokens) has a row-sized stride.
+// ggml_view_* always gives a view a unit dim-0 stride, so a token range is cut
+// from the untransposed [conv_channels, n_t, n_seqs] layout and transposed back.
+static ggml_tensor * build_token_cols(
+        ggml_context * ctx0,
+        ggml_tensor  * new_tokens, // [n_t, conv_channels, n_seqs], transposed view
+        int64_t        start,
+        int64_t        count,
+        int64_t        conv_channels,
+        int64_t        n_seqs) {
+    ggml_tensor * rows = ggml_transpose(ctx0, new_tokens);
+    GGML_ASSERT(rows->nb[0] == ggml_type_size(rows->type));
+
+    rows = ggml_view_3d(ctx0, rows,
+            conv_channels, count, n_seqs,
+            rows->nb[1], rows->nb[2],
+            start * rows->nb[1]);
+
+    return ggml_transpose(ctx0, rows);
+}
+
+ggml_tensor * build_conv_window(
+        ggml_context * ctx0,
+        ggml_tensor  * prefix,     // [dm1, conv_channels, n_seqs], contiguous
+        ggml_tensor  * new_tokens, // [n_t, conv_channels, n_seqs], possibly non-contiguous
+        int64_t        dm1,
+        int64_t        conv_channels,
+        int64_t        n_seqs,
+        int64_t        s_idx) {
+    GGML_ASSERT(s_idx >= 0 && s_idx <= new_tokens->ne[0]);
+
+    if (s_idx == 0) {
+        return prefix;
+    }
+
+    if (s_idx >= dm1) {
+        return build_token_cols(ctx0, new_tokens, s_idx - dm1, dm1, conv_channels, n_seqs);
+    }
+
+    ggml_tensor * prefix_part =
+        ggml_view_3d(ctx0, prefix,
+                dm1 - s_idx, conv_channels, n_seqs,
+                prefix->nb[1], prefix->nb[2],
+                s_idx * prefix->nb[0]);
+
+    ggml_tensor * new_tokens_part = build_token_cols(ctx0, new_tokens, 0, s_idx, conv_channels, n_seqs);
+
+    return ggml_concat(ctx0, prefix_part, new_tokens_part, 0);
+}
+
 std::pair<ggml_tensor *, ggml_tensor *> llm_build_delta_net_base::build_conv_state(
         llm_graph_input_rs * inp,
         ggml_tensor *        conv_states_all,
@@ -450,6 +511,11 @@ std::pair<ggml_tensor *, ggml_tensor *> llm_build_delta_net_base::build_conv_sta
         int64_t              conv_kernel_size,
         int64_t              conv_channels,
         int                  il) {
+    const auto * mctx_cur = inp->mctx;
+
+    const auto kv_head  = mctx_cur->get_head();
+    const auto mem_size = mctx_cur->get_size();
+
     const int64_t n_seqs = ubatch.n_seqs;
     const int64_t dm1    = conv_kernel_size - 1;
 
@@ -462,11 +528,48 @@ std::pair<ggml_tensor *, ggml_tensor *> llm_build_delta_net_base::build_conv_sta
     ggml_tensor * new_tokens = ggml_transpose(ctx0, qkv_mixed);
     cb(new_tokens, "qkv_mixed_transposed", il);
 
-    // build_conv_state_store() (llama-graph.cpp) handles both branches below generically: a direct
-    // copy when cparams.n_rs_seq == 0, and the [TAG_RECURRENT_ROLLBACK_SPLITS] vectorized ggml_set_rows
-    // scatter otherwise. It reads conv_x's own tail n_cols columns as the window to store, so it needs
-    // the raw conv_states_all storage (not the locally reshaped conv_states) and the new tokens only.
-    build_conv_state_store(inp, conv_states_all, new_tokens, dm1, 0);
+    const int64_t n_t = new_tokens->ne[0];
+
+    const int64_t row_count = dm1 * conv_channels;
+
+    const size_t row_size  = ggml_row_size(conv_states_all->type, row_count);
+
+    if (cparams.n_rs_seq == 0) {
+        const int64_t s_idx  = n_t;
+        const int64_t s_slot = 0;
+
+        ggml_tensor * conv_state_last = build_conv_window(ctx0, conv_states, new_tokens, dm1, conv_channels, n_seqs, s_idx);
+        cb(conv_state_last, "conv_state_last", il);
+
+        ggml_tensor * conv_state_update =
+            ggml_view_2d(ctx0, conv_states_all,
+                    row_count, n_seqs, conv_states_all->nb[1],
+                    (s_slot * mem_size + kv_head) * row_size);
+        cb(conv_state_update, "conv_state_update", il);
+
+        ggml_build_forward_expand(gf, ggml_cpy(ctx0, conv_state_last, conv_state_update));
+    } else {
+        // [TAG_RECURRENT_ROLLBACK_SPLITS]
+        // this logic assumes that the last (n_rs_seq + 1) tokens of a sequence in a batch are inside
+        //   the same ubatch, which `split_equal()` guarantees via its n_keep_tail argument
+
+        const int64_t K = (int64_t) cparams.n_rs_seq + 1;
+
+        for (int64_t t = 1; t <= K; ++t) {
+            const int64_t s_idx  = std::max<int64_t>(0, n_t - K + t);
+            const int64_t s_slot = K - t;
+
+            ggml_tensor * conv_state_last = build_conv_window(ctx0, conv_states, new_tokens, dm1, conv_channels, n_seqs, s_idx);
+
+            ggml_tensor * conv_state_update =
+                ggml_view_2d(ctx0,
+                        conv_states_all, row_count, n_seqs,
+                        conv_states_all->nb[1],
+                        (s_slot * mem_size + kv_head) * row_size);
+
+            ggml_build_forward_expand(gf, ggml_cpy(ctx0, conv_state_last, conv_state_update));
+        }
+    }
 
     return { conv_states, new_tokens };
 }
diff --git a/src/models/models.h b/src/models/models.h
index c145ec985..8ce2e1559 100644
--- a/src/models/models.h
+++ b/src/models/models.h
@@ -17,6 +17,16 @@ static inline ggml_tensor * build_gdn_l2_norm(ggml_context * ctx, ggml_tensor *
     return ggml_scale(ctx, ggml_rms_norm(ctx, x, eps/n), 1.0f/sqrtf(n));
 }
 
+// width-(conv_kernel_size - 1) window of concat(prefix, new_tokens) without materializing it (delta-net-base.cpp)
+ggml_tensor * build_conv_window(
+        ggml_context * ctx0,
+        ggml_tensor  * prefix,
+        ggml_tensor  * new_tokens,
+        int64_t        dm1,
+        int64_t        conv_channels,
+        int64_t        n_seqs,
+        int64_t        s_idx);
+
 //
 // base classes
 //
diff --git a/src/models/qwen4exp.cpp b/src/models/qwen4exp.cpp
index 722bb77e8..5b4d4fe0c 100644
--- a/src/models/qwen4exp.cpp
+++ b/src/models/qwen4exp.cpp
@@ -1380,6 +1380,10 @@ std::pair<ggml_tensor *, ggml_tensor *> llama_model_qwen4exp::graph::build_conv_
         int64_t              state_cols,
         int64_t              channels,
         int                  il) {
+    const auto * mctx_cur = inp->mctx;
+
+    const auto kv_head = mctx_cur->get_head();
+
     const int64_t n_seqs    = ubatch.n_seqs;
     const int64_t row_total = conv_states_all->ne[0];
 
@@ -1397,10 +1401,29 @@ std::pair<ggml_tensor *, ggml_tensor *> llama_model_qwen4exp::graph::build_conv_
 
     ggml_tensor * new_tokens = ggml_transpose(ctx0, x);
 
-    // build_conv_state_store() (llama-graph.cpp) covers the same [TAG_RECURRENT_ROLLBACK_SPLITS]
-    // rollback-slot storage generically now (vectorized ggml_set_rows); the two-row subtlety this
-    // function's docstring warns about is on the gather side above (rs_rows), not the store below.
-    build_conv_state_store(inp, conv_states_all, new_tokens, state_cols, 0);
+    const int64_t n_t = new_tokens->ne[0];
+
+    // [TAG_RECURRENT_ROLLBACK_SPLITS] keep the last state_cols columns once per rollback slot,
+    // slot s ending s tokens earlier so a rollback of s tokens reads a history that never saw them
+    // (upstream's build_conv_state_store() needs the materialized concat(history, tokens), which this
+    // function exists to avoid: it reads across the split instead, so the windows are cut by hand)
+    const size_t row_size = ggml_row_size(conv_states_all->type, row_total);
+    const uint32_t mem_size = mctx_cur->get_size();
+
+    const int64_t n_slots = (int64_t) cparams.n_rs_seq + 1;
+
+    for (int64_t slot = 0; slot < n_slots; ++slot) {
+        const int64_t s_idx = std::max<int64_t>(0, n_t - slot);
+
+        ggml_tensor * tail = build_conv_window(ctx0, state, new_tokens, state_cols, channels, n_seqs, s_idx);
+
+        ggml_tensor * dst = ggml_view_2d(ctx0, conv_states_all,
+                state_cols * channels, n_seqs,
+                conv_states_all->nb[1],
+                (slot * mem_size + kv_head) * row_size);
+
+        ggml_build_forward_expand(gf, ggml_cpy(ctx0, tail, dst));
+    }
 
     return { state, new_tokens };
 }
