++++++++++++++++++++++-+            c = literal[i]
++++++++++++++++++++++-+            if maybe_escaped_underscores and c == '_':
++++++++++++++++++++++-+                yield f'[^{c}\\\\]'
++++++++++++++++++++++-+                yield ' | '
++++++++++++++++++++++-+                yield f'"\\\\"? "{c}"'
++++++++++++++++++++++-+            else:
++++++++++++++++++++++-+                yield f'[^{c}]'
