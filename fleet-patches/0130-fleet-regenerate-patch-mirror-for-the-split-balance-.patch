+++++++++++++++++++++++++++++++++++-            if (!values.is_array() || values.empty()) {
+++++++++++++++++++++++++++++++++++-                fail(path, "enum must be a non-empty array");
+++++++++++++++++++++++++++++++++++-            }
+++++++++++++++++++++++++++++++++++-            auto node = std::make_unique<common_chat_schema_enum>();
+++++++++++++++++++++++++++++++++++-            for (const auto & value : values) {
+++++++++++++++++++++++++++++++++++-                node->values.push_back(value);
+++++++++++++++++++++++++++++++++++-            }
