++++++++++++++++++++++-+            out.append(")")
++++++++++++++++++++++-+            if c < "9":
++++++++++++++++++++++-+                out.append(" | ")
++++++++++++++++++++++-+                digit_range(chr(ord(c) + 1), "9")
