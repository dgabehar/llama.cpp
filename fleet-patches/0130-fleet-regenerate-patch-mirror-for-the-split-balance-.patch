+++++++++++++++++++++++++++++++++++-                return build_object(schema, path);
+++++++++++++++++++++++++++++++++++-            }
+++++++++++++++++++++++++++++++++++-            if (schema.contains("allOf")) {
+++++++++++++++++++++++++++++++++++-                return build_alternatives<common_chat_schema_all_of>(schema.at("allOf"), path + "/allOf");
