++++++++++++++++++++++-+            out.append("\"-\" (")
++++++++++++++++++++++-+            _generate_min_max_int(None, -min_value, out, decimals_left, top_level=False)
++++++++++++++++++++++-+            out.append(") | [0] | [1-9] ")
++++++++++++++++++++++-+            more_digits(0, decimals_left - 1)
++++++++++++++++++++++-+        elif min_value == 0:
++++++++++++++++++++++-+            if top_level:
++++++++++++++++++++++-+                out.append("[0] | [1-9] ")
