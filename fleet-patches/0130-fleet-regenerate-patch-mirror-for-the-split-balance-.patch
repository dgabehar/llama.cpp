++++++++++++++++++++++-+    def not_literal(self, literal: str, dotall: bool = True, maybe_escaped_underscores = False) -> str:
++++++++++++++++++++++-+        '''
++++++++++++++++++++++-+            not_literal('a') -> '[^a]'
