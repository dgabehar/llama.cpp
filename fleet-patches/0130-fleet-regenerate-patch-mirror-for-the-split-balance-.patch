+++++++++++++++++++++++++++++++++    {%- endfor -%}
+++++++++++++++++++++++++++++++++{%- elif fnp.p is mapping and (fnp.p.oneOf or fnp.p.anyOf or 'items' in fnp.p) -%}
+++++++++++++++++++++++++++++++++{{- render_xml_schema_children(fnp.p, true, false) }}
+++++++++++++++++++++++++++++++++{%- endif -%}
+++++++++++++++++++++++++++++++++{{- "</parameters>" }}
+++++++++++++++++++++++++++++++++{%- set fn_ret = fn.returns if fn.returns is defined else fn.response -%}
