++++++++++++++++++++++-+                out.append(" ")
++++++++++++++++++++++-+            sub_len = len(from_str) - i - 1
++++++++++++++++++++++-+            if sub_len > 0:
++++++++++++++++++++++-+                from_sub = from_str[i+1:]
++++++++++++++++++++++-+                to_sub = to_str[i+1:]
