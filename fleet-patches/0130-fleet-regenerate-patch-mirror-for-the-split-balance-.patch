++++++++++++++++++++++-+                    seq.append((get_dot(), False))
++++++++++++++++++++++-+                    i += 1
++++++++++++++++++++++-+                elif c == '(':
++++++++++++++++++++++-+                    i += 1
++++++++++++++++++++++-+                    if i < length:
++++++++++++++++++++++-+                        assert pattern[i] != '?', f'Unsupported pattern syntax "{pattern[i]}" at index {i} of /{pattern}/'
