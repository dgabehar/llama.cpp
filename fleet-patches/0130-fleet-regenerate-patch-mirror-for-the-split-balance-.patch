+++++++++++++++             }
+++++++++++++++-            if (is_integrated_gpu && !(heap.flags & vk::MemoryHeapFlagBits::eDeviceLocal)) {
+++++++++++++++-                host_free += heap_free;
+++++++++++++++-            } else {
+++++++++++++++-                *free += heap_free;
++++++++++++++++            if (i == host_heap) {
++++++++++++++++                // the budget only counts GPU allocations, not what other processes hold
++++++++++++++++                heap_free = std::min(heap_free, ggml_vk_host_mem_available());
