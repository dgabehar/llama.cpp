+++++++++++++++++++++    auto t_call = [&](uint32_t n_tokens) {
+++++++++++++++++++++        const uint32_t n_ub = (n_tokens + ub - 1) / ub;
+++++++++++++++++++++        return (n_ub - 1) * t_stage_max + t_stage_sum;
