++++++++++++++++++++++-+                yield ' | '
++++++++++++++++++++++-+                yield self._format_literal(c)
++++++++++++++++++++++-+                yield ' ('
++++++++++++++++++++++-+                yield from recurse(i + 1)
++++++++++++++++++++++-+                yield ')?'
