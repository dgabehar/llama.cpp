++++++++++++++++++++++-+                    out.append("[")
++++++++++++++++++++++-+                    out.append(from_str[i])
++++++++++++++++++++++-+                    out.append("] ")
++++++++++++++++++++++-+                    out.append("(")
++++++++++++++++++++++-+                    uniform_range(from_sub, sub_nines)
++++++++++++++++++++++-+                    out.append(")")
