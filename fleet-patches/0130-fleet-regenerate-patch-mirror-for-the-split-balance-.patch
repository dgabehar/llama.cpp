+++++++++++++++++++++++++++++-            LLAMA_LOG_DEBUG("load_tensors: layer %3d assigned to device %s, is_swa = %d\n", il, ggml_backend_dev_name(cpu_dev), is_swa);
+++++++++++++++++++++++++++++-            return {cpu_dev, &pimpl->cpu_buft_list};
