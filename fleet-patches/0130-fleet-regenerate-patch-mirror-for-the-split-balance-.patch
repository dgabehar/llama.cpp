+++++++++++++++++++++++++++++++++++-template <typename T>
+++++++++++++++++++++++++++++++++++-static const T & as(testing & t, const common_chat_schema * node, const char * what) {
+++++++++++++++++++++++++++++++++++-    const T * typed = dynamic_cast<const T *>(node);
