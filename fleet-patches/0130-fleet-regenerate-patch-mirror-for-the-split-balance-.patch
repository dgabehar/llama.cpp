++++++++++++++++++++++-+
++++++++++++++++++++++-+    if max_value is not None:
++++++++++++++++++++++-+        if max_value >= 0:
++++++++++++++++++++++-+            if top_level:
++++++++++++++++++++++-+                out.append("\"-\" [1-9] ")
++++++++++++++++++++++-+                more_digits(0, less_decimals)
++++++++++++++++++++++-+                out.append(" | ")
