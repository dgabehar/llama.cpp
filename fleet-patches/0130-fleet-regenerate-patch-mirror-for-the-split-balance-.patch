++++++++++++++++++++++-+class SchemaConverter:
++++++++++++++++++++++-+    def __init__(self, *, prop_order, allow_fetch, dotall, raw_pattern):
++++++++++++++++++++++-+        self._prop_order = prop_order
++++++++++++++++++++++-+        self._allow_fetch = allow_fetch
++++++++++++++++++++++-+        self._dotall = dotall
++++++++++++++++++++++-+        self._raw_pattern = raw_pattern
