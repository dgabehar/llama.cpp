+++++++++++++++++++++++++++++++++++-    common_chat_schema_builder(const common_json & root, common_chat_schema_document & doc) : root_(root), doc_(doc) {}
+++++++++++++++++++++++++++++++++++-
+++++++++++++++++++++++++++++++++++-    common_chat_schema_ptr build() {
+++++++++++++++++++++++++++++++++++-        auto node = build_node(root_, "#");
