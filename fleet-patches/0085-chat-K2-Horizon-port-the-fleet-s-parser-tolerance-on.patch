+        // The sampler guard: the official weights sometimes end the turn with their very first token (EOG) or
+        // inside an unfinished reasoning block / tool-call opener. These are the inputs it needs. A future
+        // upstream parser change that stops filling them silently disarms the guard: tests/test-chat.cpp pins them.
+        for (const auto & n : think_names) {
+            data.no_empty_reply_inert.push_back("<" + n + ">");
+            data.no_empty_reply_inert.push_back("</" + n + ">");
+        }
+        if (has_tools) {
+            data.no_empty_reply_hold = { SECTION_START, SECTION_END, CALL_START, CALL_END, ARG_KEY, ARG_KEY_END,
