+        }
+    }
+    std::vector<std::string> open_tags;
+    std::vector<std::string> close_tags;
+    for (const auto & n : think_names) {
+        open_tags.push_back("<" + n + ">");
+        close_tags.push_back("</" + n + ">");
+    }
+
+    // what may follow the answer before the model derails: a second close tag, harmony/Kimi delimiters, EOG text
+    std::vector<std::string> stray_ends = close_tags;
+    stray_ends.insert(stray_ends.end(), { "<|close|>", "<|sep|>", "<|open|>", "<|ifm|im_end|>", "<|ifm|endoftext|>" });
