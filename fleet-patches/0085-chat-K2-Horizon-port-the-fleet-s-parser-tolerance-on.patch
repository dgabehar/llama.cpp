+    // The official weights do not stick to the template's shape (FLEET.md "K2-Horizon"): any effort's open tag
+    // may be emitted, any effort's close tag may end the reasoning, a call may follow without a close tag, ...
+    // Every effort's tag family is therefore accepted; the request's own tag only comes first.
+    std::vector<std::string> think_names = { think };
+    for (const char * n : { "ifm|think", "ifm|think_fast", "ifm|think_faster" }) {
+        if (think != n) {
