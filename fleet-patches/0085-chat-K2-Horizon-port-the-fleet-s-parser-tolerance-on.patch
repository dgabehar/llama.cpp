+    const std::vector<std::string> stray_ends_no_tools = {
+        ARG_VAL_END, CALL_END, SECTION_END, SECTION_START, CALL_START, ARG_KEY, ARG_VAL,
+        "<|tool_calls_section_begin|>", "<|tool_call_begin|>",
+    };
