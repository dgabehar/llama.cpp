+        // dropped remainder is not decoded (and waited for) to EOS
+        data.stops_after_reasoning = stray_ends;
+        if (!uses_tools) {
+            data.stops_after_reasoning.insert(data.stops_after_reasoning.end(), stray_ends_no_tools.begin(), stray_ends_no_tools.end());
+        }
