+// TEST_CHAT_QWEN_GGUF (loaded vocab-only) checks the Qwen3.5 and Qwen3 routes with the real token.
 static void test_tool_choice_none_suppresses_call_opener() {
     LOG_DBG("%s\n", __func__);
     common_chat_msg user;
