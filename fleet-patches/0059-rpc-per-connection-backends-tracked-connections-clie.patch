+        setsockopt(fd, IPPROTO_TCP, TCP_KEEPINTVL, &interval_sec, sizeof(interval_sec)) != 0 ||
+        setsockopt(fd, IPPROTO_TCP, TCP_KEEPCNT,   &count,        sizeof(count))        != 0) {
